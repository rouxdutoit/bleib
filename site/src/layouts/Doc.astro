---
/** Subpages, styled like fazit.dev's: big title and intro, then two-column sections (heading left). */
import Lines from '../components/Lines.astro';
import Base from './Base.astro';
import Rails from '../components/Rails.astro';
import ProviderLogo from '../components/ProviderLogo.astro';
import StoryVisual from '../components/StoryVisual.astro';
import Mark from '../components/Mark.astro';
import reserveScenes from '../scripts/reserve.js?raw';
import { icon } from '../components/icons';
import { docs, type Block } from '../i18n/pages';
import { routes, type Lang, type RouteKey } from '../i18n/strings';
interface Props { lang: Lang; page: Exclude<RouteKey, 'home'> }
const { lang, page } = Astro.props;
const d = docs[lang][page];
const is = <K extends string>(b: Block, k: K): b is Extract<Block, Record<K, unknown>> => k in b;
---
<Base lang={lang} page={page} title={d.title} description={d.description}>
  <article class="doc">
    <header class="doc-hero has-rails">
      <Rails top={false} />
      <div class="wrap hero-in">
        <h1 class="doc-h1">{d.title}</h1>
        {d.intro.map((p) => <p class="doc-intro"><Lines text={p} /></p>)}
        {d.cta && <a class="btn btn-secondary doc-cta" href={d.cta.href}>{d.cta.label}</a>}
        {d.visual !== undefined && (
          <>
            {/* The page's homepage card: it holds its finished height (scripts/reserve.js) and plays when seen. */}
            <script is:inline set:html={reserveScenes} />
            <figure class="doc-visual"><StoryVisual lang={lang} scene={d.visual} tray /></figure>
            <script is:inline>bleibReserve(document.currentScript.previousElementSibling)</script>
          </>
        )}
        {d.hub && (
          <ul class="hub">
            {d.hub.map((h) => (
              <li>
                <a href={routes[h.to][lang]}>
                  <span class="ti" set:html={icon(h.icon)} />
                  <span class="hub-go" aria-hidden="true" set:html={icon('chevron_right')} />
                  <span class="hub-t">{h.t}</span>
                  <span class="hub-d">{h.d}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>
    <div class="doc-body">
        {d.sections.map((sec) => (
          <section class="band has-rails" id={sec.id}>
            <Rails />
            <div class="wrap sec">
            <h2 class="sec-h">{sec.h}</h2>
            <div class="sec-c">
              {sec.blocks.map((b) =>
                is(b, 'never') ? (
                  <ul class="never">{b.never.map((x) => <li><span class="ni" set:html={icon('verified_user')} /><span>{x}</span></li>)}</ul>
                ) : is(b, 'refs') ? (
                  <dl class="kv refs">{b.refs.map((r) => <div><dt><a href={r.href} rel="noopener"><span class="lbl">{r.name}</span><span class="chev" set:html={icon('chevron_right')} /></a></dt><dd>{r.v}</dd></div>)}</dl>
                ) : is(b, 'rows') ? (
                  <dl class="kv">{b.rows.map((r) => <div><dt>{r.k}</dt><dd>{r.v}</dd></div>)}</dl>
                ) : is(b, 'compare') ? (
                  <table class="cmp">
                    <thead><tr>
                      <td></td>
                      <th scope="col" class="us"><span class="cmp-logos"><span class="cmp-mark"><Mark size={14} /></span></span>{b.compare.head[0]}</th>
                      <th scope="col"><span class="cmp-logos stack">{['ChatGPT', 'Claude', 'Gemini'].map((n) => <span class="cmp-ai"><ProviderLogo name={n} lang={lang} size={13} /></span>)}</span>{b.compare.head[1]}</th>
                    </tr></thead>
                    <tbody>{b.compare.rows.map((r) => (
                      <tr>
                        <th scope="row">{r[0]}</th>
                        {[r[1], r[2]].map((v, i) => (
                          <td class:list={[v ? 'yes' : 'no', { us: i === 0 }]}><span class="cmp-sym" set:html={icon(v ? 'check' : 'remove')} /><span class="sr-only">{v ? b.compare.yes : b.compare.no}</span></td>
                        ))}
                      </tr>
                    ))}</tbody>
                  </table>
                ) : is(b, 'tiles') ? (
                  <ul class="tiles">
                    {b.tiles.map((tl) => (
                      <li class:list={['tile', { 'has-tag': tl.tag, 'has-ai': tl.ai }]}>
                        {tl.tag && <span class="tag">{tl.tag}</span>}
                        {tl.icon && <span class="ti" set:html={icon(tl.icon)} />}
                        {tl.ai && <span class="tl-ai"><ProviderLogo name={tl.ai} lang={lang} size={24} /></span>}
                        <div class="tile-x"><p class="tile-t">{tl.t}</p><p class="tile-d">{tl.d}</p></div>
                      </li>
                    ))}
                  </ul>
                ) : is(b, 'list') ? (
                  <ul class="bul">{b.list.map((li) => <li>{li}</li>)}</ul>
                ) : is(b, 'code') ? (
                  <pre><code>{b.code}</code></pre>
                ) : is(b, 'address') ? (
                  <address>{b.address.map((line, i) => (<>{line}{i < b.address.length - 1 && <br />}</>))}</address>
                ) : (
                  <p>{(b as { p: string }).p}</p>
                ),
              )}
            </div>
            </div>
          </section>
        ))}
    </div>
  </article>
</Base>
<style>
  .doc-hero { padding: clamp(140px, 18vh, 190px) 0 clamp(64px, 8vw, 104px); }
  .hero-in { position: relative; z-index: 1; }
  .doc-h1 { font-size: clamp(40px, 5.2vw, 60px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; max-width: 16ch; }
  .doc-intro { margin: 18px 0 0; max-width: 36em; font-size: clamp(17px, 1.6vw, 20px); line-height: 1.5; color: var(--muted); }
  .doc-intro + .doc-intro { margin-top: 10px; }
  .doc-cta { margin-top: 28px; }
  /* Hub: Apple-style link tiles to the deeper pages */
  .hub { list-style: none; margin: clamp(36px, 5vw, 56px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  /* Like Apple's cards: the symbol top left, a round button top right that says the tile opens a page. */
  .hub a { position: relative; display: grid; gap: 4px; height: 100%; padding: 18px 18px 20px; border-radius: 20px; background: var(--card); color: var(--on-card); border: var(--card-border); text-decoration: none; transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease); }
  .hub a:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  /* The symbol stands on its own, without a square behind it, so it never competes with the round button. */
  .hub .ti { width: 28px; height: 28px; margin-bottom: 10px; background: none; place-items: center start; }
  .hub .ti :global(svg) { width: 24px; height: 24px; }
  .hub-go { position: absolute; top: 18px; right: 18px; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--fill); color: var(--label); transition: transform 0.25s var(--ease); }
  .hub-go :global(svg) { width: 18px; height: 18px; display: block; }
  .hub a:hover .hub-go, .hub a:focus-visible .hub-go { transform: translateX(2px); }
  .hub-t { font-weight: 600; letter-spacing: -0.015em; }
  .hub-d { color: var(--on-card-muted); font-size: 15px; line-height: 1.4; }
  @media (max-width: 860px) { .hub { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* Each section is its own band: a rail-to-rail divider with joiners on top, like the hero line. */
  .band { scroll-margin-top: 72px; }
  .doc-body .wrap { position: relative; z-index: 1; }
  .sec { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(24px, 5vw, 72px); padding: clamp(48px, 6vw, 80px) 0; }
  .sec-h { font-size: 22px; line-height: 28px; font-weight: 600; letter-spacing: -0.02em; }
  .sec-c { min-width: 0; max-width: 680px; }
  .sec-c > * + * { margin-top: 16px; }
  .sec-c p, .sec-c li, .sec-c address, .sec-c dd, .sec-c dt { font-size: 17px; line-height: 1.55; font-style: normal; }
  .sec-c p { margin: 0; }

  .never, .bul, .tiles { list-style: none; margin: 0; padding: 0; }
  .never li { display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-top: 1px solid var(--rail); }
  .never li:first-child { border-top: 0; padding-top: 0; }
  .ni { flex: none; margin-top: 2px; color: var(--muted); }
  .ni :global(svg) { width: 20px; height: 20px; display: block; }
  .bul { display: grid; gap: 8px; padding-left: 1.1em; list-style: disc; }

  .kv { margin: 0; }
  .kv div { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr); gap: 16px; padding: 11px 0; border-top: 1px solid var(--rail); }
  .kv div:first-child { border-top: 0; padding-top: 0; }
  .kv dt { color: var(--muted); }
  .kv dd { margin: 0; }
  .refs dt a { display: inline; color: var(--ink); font-weight: 500; text-decoration: none; }
  .refs dt .chev { vertical-align: -5px; margin-left: -1px; }
  .refs dd { color: var(--muted); }

  /* Comparison as a checklist, like Apple's: each benefit gets the full width, then a tick or a dash for bleib and for
     each AI's own memory. Ticks and dashes differ in shape (and say Yes/No to screen readers), so nothing depends on
     colour. Each column is headed by its logo. */
  .cmp { width: 100%; table-layout: fixed; border-collapse: collapse; border-radius: 20px; overflow: hidden; background: var(--card); color: var(--on-card); border: var(--card-border); }
  .cmp th, .cmp td { padding: 12px 16px; vertical-align: middle; }
  .cmp thead th { width: 76px; padding: 16px 8px 10px; text-align: center; font-size: 13px; line-height: 18px; font-weight: 600; color: var(--on-card-muted); }
  .cmp thead .us { color: var(--on-card); }
  .cmp-logos { display: flex; justify-content: center; align-items: center; gap: 3px; height: 24px; margin-bottom: 4px; }
  /* The three AIs as overlapping circles, like a group in Messages, so they sit as neatly as bleib's one mark. */
  .stack { gap: 0; }
  .cmp-ai { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--fill); box-shadow: 0 0 0 2px var(--card); }
  .cmp-ai + .cmp-ai { margin-left: -6px; }
  .cmp-mark { width: 24px; height: 24px; border-radius: 6px; display: grid; place-items: center; background: #0a0a0a; color: #f6e79a; }
  :global(:root[data-theme='dark']) .cmp-mark { background: #f6e79a; color: #0a0a0a; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .cmp-mark { background: #f6e79a; color: #0a0a0a; } }
  .cmp tbody tr { border-top: 1px solid var(--hairline); }
  .cmp tbody th { text-align: left; font-size: 17px; line-height: 22px; font-weight: 400; }
  .cmp td { width: 76px; padding: 12px 8px; text-align: center; }
  .cmp thead td { width: auto; }
  .cmp-sym { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; vertical-align: middle; }
  .cmp-sym :global(svg) { width: 17px; height: 17px; display: block; }
  .yes .cmp-sym { background: #f6e79a; color: #0a0a0a; }
  .no .cmp-sym { color: var(--on-card-muted); }
  @media (max-width: 560px) {
    .cmp tbody th { padding-right: 4px; font-size: 16px; line-height: 21px; }
    .cmp thead th, .cmp tbody td { width: 72px; }
    .cmp thead th { padding-left: 2px; padding-right: 2px; white-space: nowrap; }
    .cmp tbody th { padding-left: 16px; }
  }

  .doc-visual { margin: clamp(40px, 5vw, 56px) 0 0; width: 100%; max-width: 440px; }

  .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  /* Tags sit in the corner so titles line up across a row, with or without a tag. */
  .tile { position: relative; padding: 18px 20px; border-radius: 20px; background: var(--card); color: var(--on-card); border: var(--card-border); }
  .tile.has-tag .tile-t { padding-right: 84px; }
  .ti { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: var(--fill); color: var(--label); margin-bottom: 12px; }
  .ti :global(svg) { width: 20px; height: 20px; display: block; }
  .tag { position: absolute; top: 16px; right: 16px; padding: 2px 9px; border-radius: 999px; background: #f6e79a; color: #0a0a0a; font-size: 12px; line-height: 18px; font-weight: 600; }
  .tile-t { font-weight: 600; letter-spacing: -0.015em; }
  /* An AI's tile: its logo in a rounded square exactly as tall as the name and address beside it (22 + 20px). */
  .has-ai { display: flex; align-items: center; gap: 14px; }
  .tl-ai { flex: none; width: 42px; height: 42px; border-radius: 10px; display: grid; place-items: center; background: var(--fill); }
  .has-ai .tile-t { line-height: 22px; }
  .has-ai .tile-d { margin-top: 0 !important; line-height: 20px !important; }
  .tile-d { margin-top: 4px !important; color: var(--on-card-muted); font-size: 15px !important; line-height: 1.45 !important; }

  pre { margin: 0; padding: 12px 16px; border-radius: 14px; background: var(--card); color: var(--on-card); border: var(--card-border); overflow-x: auto; }
  .sec-c pre + pre { margin-top: 8px; }
  code { font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 14px; }

  @media (max-width: 860px) {
    .sec { grid-template-columns: 1fr; gap: 14px; }
  }
  @media (max-width: 560px) {
    .tiles { grid-template-columns: 1fr; }
    .kv div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>

<script>
  import { initStory } from '../scripts/story';
  initStory();
</script>
