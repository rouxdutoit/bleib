---
/**
 * The launch-day plans on Pricing: Free beside bleib everywhere, set out like Apple's subscription sheets. The paid
 * plan is a selection list with a trailing checkmark (Yearly, chosen first, or Monthly); its billed amount is the
 * largest price, the monthly equivalent smaller; then one capsule and the terms in plain words.
 */
import { icon } from './icons';
import { INSTALL } from '../config/install';
import type { PlansBlock } from '../i18n/pages';
interface Props { plans: PlansBlock }
const { plans: p } = Astro.props;
const href = (id: string) => (id === 'monthly' ? INSTALL.checkoutMonthlyUrl : INSTALL.checkoutYearlyUrl) || '#';
---
<div class="plans" data-plans>
  <div class="plan">
    <p class="name">{p.free.name}</p>
    <p class="price"><span class="amount">{p.free.price}</span> <span class="per">{p.free.per}</span></p>
    <ul class="pts">{p.free.points.map((x) => <li><span class="tick" set:html={icon('check')} />{x}</li>)}</ul>
  </div>
  <div class="plan paid">
    <p class="name">{p.paid.name}</p>
    <p class="lede">{p.paid.lede}</p>
    <fieldset class="opts">
      <legend class="sr-only">{p.paid.choose}</legend>
      {p.paid.options.map((o, i) => (
        <label class="opt">
          <input type="radio" name="period" value={o.id} checked={i === 0} data-href={href(o.id)} data-fine={o.fine} />
          <span class="opt-t">{o.label}{o.badge && <span class="badge">{o.badge}</span>}</span>
          <span class="opt-p"><span class="amount">{o.price}</span>{o.note && <span class="note">{o.note}</span>}</span>
          <span class="check" aria-hidden="true" set:html={icon('check')} />
        </label>
      ))}
    </fieldset>
    <a class="btn btn-primary go" href={href(p.paid.options[0].id)} data-go>{p.paid.button}</a>
    <p class="fine" data-fine-out aria-live="polite">{p.paid.options[0].fine}</p>
    <ul class="pts">{p.paid.points.map((x) => <li><span class="tick" set:html={icon('check')} />{x}</li>)}</ul>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-plans]').forEach((root) => {
    const go = root.querySelector<HTMLAnchorElement>('[data-go]');
    const fine = root.querySelector<HTMLElement>('[data-fine-out]');
    root.querySelectorAll<HTMLInputElement>('input[name="period"]').forEach((input) => input.addEventListener('change', () => {
      if (go && input.dataset.href) go.href = input.dataset.href;
      if (fine) fine.textContent = input.dataset.fine ?? '';
    }));
  });
</script>

<style>
  .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
  @media (max-width: 767px) { .plans { grid-template-columns: 1fr; } }
  .plan { padding: 24px 20px; border-radius: 20px; background: var(--card); color: var(--on-card); border: var(--card-border); }
  .name { margin: 0; font-size: 17px; line-height: 22px; font-weight: 600; }
  .price { margin: 6px 0 0; }
  .amount { font-size: 28px; line-height: 34px; font-weight: 600; letter-spacing: -0.01em; }
  .per { font-size: 15px; color: var(--on-card-muted); }
  .lede { margin: 6px 0 0; font-size: 15px; line-height: 20px; color: var(--on-card-muted); }
  .pts { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 10px; font-size: 15px; line-height: 20px; }
  .pts li { display: grid; grid-template-columns: 18px 1fr; gap: 8px; }
  .tick { color: var(--on-card); }
  .tick :global(svg) { width: 18px; height: 18px; display: block; }

  /* Inset grouped selection list: each period a 44px row with a trailing checkmark on the chosen one. */
  .opts { margin: 18px 0 0; padding: 0; border: 0; border-radius: 12px; overflow: hidden; background: var(--fill); }
  .opt { position: relative; display: grid; grid-template-columns: 1fr auto 22px; align-items: center; gap: 12px; min-height: 56px; padding: 8px 14px; cursor: pointer; }
  .opt + .opt { background: linear-gradient(var(--hairline), var(--hairline)) 14px 0 / calc(100% - 14px) 1px no-repeat; }
  .opt input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .opt:has(input:focus-visible) { outline: 2px solid var(--on-card); outline-offset: -2px; border-radius: 12px; }
  .opt-t { display: flex; flex-wrap: wrap; align-items: center; column-gap: 8px; row-gap: 2px; font-size: 17px; line-height: 22px; }
  .badge { white-space: nowrap; padding: 1px 8px; border-radius: 999px; background: #f6e79a; color: #0a0a0a; font-size: 12px; line-height: 16px; font-weight: 600; }
  .opt-p { display: grid; justify-items: end; text-align: right; white-space: nowrap; }
  .opt-p .amount { font-size: 17px; line-height: 22px; }
  .note { font-size: 13px; line-height: 18px; color: var(--on-card-muted); }
  .check { visibility: hidden; color: var(--on-card); }
  .check :global(svg) { width: 20px; height: 20px; display: block; }
  .opt:has(input:checked) .check { visibility: visible; }

  .go { margin-top: 18px; width: 100%; justify-content: center; }
  .fine { margin: 10px 0 0; font-size: 13px; line-height: 18px; color: var(--on-card-muted); text-align: center; text-wrap: balance; }
</style>
