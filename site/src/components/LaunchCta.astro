---
/**
 * Launch-day actions, for the hero and the finale (config/install.ts: `launched`, `connectors`). Rendered hidden until
 * launch; scripts/launch.ts shows the right one for the visitor's device:
 * - a computer with Chrome, Edge or Firefox: one capsule, "Add to {browser}" (or "Open bleib" once installed), and a
 *   the browser's own colour logo just before its name, then a line of information,
 *   "Works with ChatGPT › Claude › Gemini ›", each a link to that AI's site with its own colour logo;
 * - a phone or Safari, where no extension can run: with connectors, two capsules, ChatGPT and Claude,
 *   then "Get it for your computer ›" as text, 20px below (the capsules' logos say where they go, so no label); without them, "Get bleib for your computer" as the one capsule. That link
 *   opens the share sheet with bleib.dev, or copies the link. Gemini has no capsule: its app takes no outside apps.
 */
import { INSTALL } from '../config/install';
import { routes, t, type Lang } from '../i18n/strings';
import { icon } from './icons';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).launch;
const h = t(lang).hero;
const shareUrl = new URL(routes.home[lang], Astro.site ?? 'https://bleib.dev').href;
/* Colour logos where the AI has one; ChatGPT's mark is single-colour, so it takes the text colour. */
const works = [
  { name: 'ChatGPT', mono: '/providers/openai.svg', href: 'https://chatgpt.com/' },
  { name: 'Claude', color: '/providers/claude-color.svg', href: 'https://claude.ai/' },
  { name: 'Gemini', color: '/providers/gemini-color.svg', href: 'https://gemini.google.com/' },
];
const apps = [
  // Claude in colour; ChatGPT's mark is single-colour, so it takes the capsule's ink.
  { name: 'ChatGPT', icon: '/providers/openai.svg', color: '', href: INSTALL.chatgptConnectorUrl },
  { name: 'Claude', icon: '/providers/claude.svg', color: '/providers/claude-color.svg', href: INSTALL.claudeConnectorUrl },
];
---
<div class="launch" data-launch hidden={!INSTALL.launched} data-share-url={shareUrl} data-share-text={s.shareText} data-copied={s.copied}>
  <div class="desk" data-l="desktop">
    <a class="btn btn-primary" data-l-primary href="#" data-add={h.addTo} data-open={s.open}>{h.addTo.replace('{browser}', 'Chrome')}</a>
    <p class="works t-sub">
      <span>{s.worksWith}</span>
      {works.map((a) => <a class="ai" href={a.href} rel="noopener">{a.color ? <img class="logo" src={a.color} alt="" width="16" height="16" /> : <span class="mono" aria-hidden="true" style={`--logo: url(${a.mono})`} />}<span class="lbl">{a.name}</span><span class="chev" aria-hidden="true" set:html={icon('chevron_right')} /></a>)}
    </p>
  </div>
  <div class="phone" data-l="mobile" hidden>
    <div class="with" data-l-connectors hidden={!INSTALL.connectors}>
      <div class="caps">
        {apps.map((a) => <a class="btn btn-primary cap" href={a.href || '#'} rel="noopener">{a.color ? <img class="clogo" src={a.color} alt="" width="18" height="18" /> : <span class="mono" aria-hidden="true" style={`--logo: url(${a.icon})`} />}{a.name}</a>)}
      </div>
      <button type="button" class="link t-sub" data-share><span class="lbl">{s.share}</span><span class="chev" set:html={icon('chevron_right')} /></button>
    </div>
    <div class="without" data-l-noconnectors hidden={INSTALL.connectors}>
      <button type="button" class="btn btn-primary" data-share>{s.shareAlone}</button>
    </div>
  </div>
  <p class="sr-only" role="status" data-share-status></p>
</div>

<style>
  .launch { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .launch[hidden], .launch [hidden] { display: none !important; }
  .desk, .phone, .with, .without { display: flex; flex-direction: column; align-items: center; }
  /* Under the one primary capsule, where it works: each AI as an Apple-style "Name ›" link to its site, where the
     extension works, its logo at text size and centred on the text with "Works with". */
  .works { margin: 20px 0 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; column-gap: 14px; row-gap: 4px; color: var(--muted); }
  .ai { position: relative; display: inline-flex; align-items: center; gap: 5px; color: var(--label); font-weight: 500; text-decoration: none; white-space: nowrap; }
  .ai:hover .lbl { text-decoration: underline; }
  .ai::after { content: ''; position: absolute; left: -4px; right: -4px; top: calc(50% - 22px); bottom: calc(50% - 22px); }
  .ai .chev { margin-left: -3px; }
  .logo { flex: none; width: 0.95em; height: 0.95em; display: block; }
  /* The browser's logo inside the main capsule, set by scripts/launch.ts. */
  :global(.btn .blogo) { display: inline-block; width: 1.05em; height: 1.05em; margin: 0 5px 0 3px; vertical-align: -0.18em; }
  .mono { flex: none; width: 0.95em; height: 0.95em; align-self: center; background: currentColor; mask: var(--logo) center / contain no-repeat; -webkit-mask: var(--logo) center / contain no-repeat; }
  .caps { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .cap { gap: 8px; }
  .clogo { flex: none; width: 1.05em; height: 1.05em; display: block; }
  /* Apple's "Learn more ›": Subheadline text with a chevron, quieter than the capsules; the tap area still reaches 44px. */
  .link { display: inline-flex; align-items: center; gap: 1px; margin-top: 8px; min-height: 44px; padding: 0 8px; border: 0; background: none; color: var(--label); font-family: inherit; font-weight: 500; cursor: pointer; }
  .link:hover .lbl { text-decoration: underline; }
  .chev { display: grid; }
  .chev :global(svg) { width: 1em; height: 1em; display: block; }
</style>
