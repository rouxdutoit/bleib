---
/**
 * The privacy promise: bleib's one inverted moment. A black vault (yellow in dark mode) with the promise
 * in bleib yellow, a lock that clicks shut as it comes into view (scripts/story.ts), then four short proofs.
 */
import Lines from './Lines.astro';
import Rails from './Rails.astro';
import { icon, type IconName } from './icons';
import { routes, t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).privacy;
---
<section class="privacy has-rails" aria-labelledby="privacy-title">
  <Rails />
  <div class="wrap">
    <div class="vault">
      <div class="badge" aria-hidden="true" data-sv data-steps="1" data-step="0">
        <svg viewBox="0 0 24 24" focusable="false">
          <path class="shackle" d="M8.25 10.5V8a3.75 3.75 0 0 1 7.5 0v2.5" />
          <rect x="5" y="10" width="14" height="10.5" rx="2.75" />
          <circle cx="12" cy="15.25" r="1.6" />
        </svg>
      </div>
      <p class="eyebrow">{s.eyebrow}</p>
      <h2 id="privacy-title" class="title">{s.h}</h2>
      <ul class="items">
        {s.items.map((x) => (
          <li class="tile">
            <span class="ico" set:html={icon(x.icon as IconName)} />
            <p class="t-headline name">{x.t}</p>
            <p class="d"><Lines text={x.d} /></p>
          </li>
        ))}
      </ul>
      <a class="more" href={routes.security[lang]}>{s.more}<span set:html={icon('chevron_right')} /></a>
    </div>
  </div>
</section>

<style>
  .privacy { position: relative; padding: clamp(48px, 7vw, 96px) 0; }
  .wrap { position: relative; z-index: 1; }

  /* Light: black with bleib yellow. Dark: the same moment inverted, so it still stands apart from the page. */
  .vault {
    --v-bg: #0a0a0a; --v-ink: #f6e79a; --v-muted: rgb(245 241 230 / 0.62);
    --v-tile: rgb(255 255 255 / 0.045); --v-hair: rgb(246 231 154 / 0.1); --v-glyph: #0a0a0a;
    --focus: #f6e79a;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: clamp(64px, 9vw, 120px) clamp(20px, 5vw, 72px) clamp(48px, 7vw, 88px);
    border-radius: clamp(28px, 3vw, 40px); background: var(--v-bg); color: var(--v-ink);
    box-shadow: var(--shadow);
  }
  :global(:root[data-theme='dark']) .vault {
    --v-bg: #f6e79a; --v-ink: #0a0a0a; --v-muted: rgb(10 10 10 / 0.66);
    --v-tile: rgb(10 10 10 / 0.05); --v-hair: rgb(10 10 10 / 0.08); --v-glyph: #f6e79a; --focus: #0a0a0a;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .vault {
      --v-bg: #f6e79a; --v-ink: #0a0a0a; --v-muted: rgb(10 10 10 / 0.66);
      --v-tile: rgb(10 10 10 / 0.05); --v-hair: rgb(10 10 10 / 0.08); --v-glyph: #f6e79a; --focus: #0a0a0a;
    }
  }

  /* The lock: open until the vault comes into view, then the shackle drops shut with a little give. */
  .badge { width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; background: var(--v-ink); color: var(--v-glyph); margin-bottom: 28px; box-shadow: 0 0 0 0 rgb(246 231 154 / 0); transition: box-shadow 0.9s var(--ease) 0.25s; }
  .badge svg { width: 36px; height: 36px; display: block; overflow: visible; }
  .badge rect, .badge circle { fill: currentColor; }
  .badge circle { fill: var(--v-ink); }
  .shackle { fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; transform: translateY(-3.5px); transition: transform 0.45s cubic-bezier(0.3, 1.5, 0.5, 1) 0.1s; }
  .badge.s1 .shackle { transform: none; }
  .badge.s1 { box-shadow: 0 0 0 14px color-mix(in srgb, var(--v-ink) 10%, transparent); }

  .eyebrow { margin: 0 0 12px; font-size: 15px; font-weight: 600; color: var(--v-ink); opacity: 0.7; }
  .title { margin: 0; font-size: clamp(40px, 6vw, 76px); line-height: 1.03; letter-spacing: -0.035em; font-weight: 700; text-wrap: balance; color: var(--v-ink); }

  .items { list-style: none; margin: clamp(48px, 6vw, 72px) 0 0; padding: 0; width: 100%; max-width: 860px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; text-align: left; }
  .tile { display: flex; flex-direction: column; padding: 24px 22px 26px; border-radius: var(--radius-card); background: var(--v-tile); box-shadow: inset 0 0 0 1px var(--v-hair); }
  .tile p { margin: 0; }
  .ico { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--v-ink); color: var(--v-glyph); margin-bottom: 18px; }
  .ico :global(svg) { width: 22px; height: 22px; display: block; }
  .name { color: var(--v-ink); }
  .d { margin-top: 6px !important; font-size: 15px; line-height: 1.45; color: var(--v-muted); }

  .more { display: inline-flex; align-items: center; gap: 1px; margin-top: clamp(36px, 5vw, 56px); font-size: 17px; font-weight: 500; text-decoration: none; color: var(--v-ink); }
  .more :global(svg) { width: 20px; height: 20px; display: block; transition: transform 0.2s var(--ease); }
  .more:hover { text-decoration: underline; text-underline-offset: 4px; }
  .more:hover :global(svg) { transform: translateX(2px); }

  @media (max-width: 600px) { .items { grid-template-columns: minmax(0, 1fr); } .tile { padding: 20px 20px 22px; } }
  @media (prefers-reduced-motion: reduce) { .shackle, .badge { transition: none; } }
</style>
