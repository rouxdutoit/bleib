---
/**
 * The privacy promise: the one section in bleib's inverted colours. The whole box between the rails is black
 * with bleib yellow (yellow with black in dark mode), then four short proofs.
 */
import Lines from './Lines.astro';
import Rails from './Rails.astro';
import { icon, type IconName } from './icons';
import { routes, t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).privacy;
---
<section class="privacy has-rails" aria-labelledby="privacy-title">
  <Rails />
  <div class="wrap inner">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2 id="privacy-title" class="title">{s.h}</h2>
    <ul class="items">
      {s.items.map((x) => (
        <li>
          <span class="ico" set:html={icon(x.icon as IconName)} />
          <p class="t-headline name">{x.t}</p>
          <p class="d"><Lines text={x.d} /></p>
        </li>
      ))}
    </ul>
    <a class="more" href={routes.security[lang]}>{s.more}<span set:html={icon('chevron_right')} /></a>
  </div>
</section>

<style>
  .privacy {
    --v-bg: #0a0a0a; --v-ink: #f6e79a; --v-muted: rgb(245 241 230 / 0.62); --v-glyph: #0a0a0a; --focus: #f6e79a;
    padding: clamp(80px, 10vw, 128px) 0;
  }
  :global(:root[data-theme='dark']) .privacy { --v-bg: #f6e79a; --v-ink: #0a0a0a; --v-muted: rgb(10 10 10 / 0.64); --v-glyph: #f6e79a; --focus: #0a0a0a; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .privacy { --v-bg: #f6e79a; --v-ink: #0a0a0a; --v-muted: rgb(10 10 10 / 0.64); --v-glyph: #f6e79a; --focus: #0a0a0a; }
  }
  /* Fills exactly the rails' box, so the rails and their joints still frame it. */
  .privacy::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: var(--rails-box); transform: translateX(-50%); background: var(--v-bg); }

  .inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; color: var(--v-ink); }
  .eyebrow { margin: 0 0 14px; font-size: 15px; font-weight: 600; opacity: 0.7; }
  .title { font-size: clamp(36px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.035em; font-weight: 700; text-wrap: balance; color: var(--v-ink); }

  .items { list-style: none; margin: clamp(44px, 6vw, 64px) 0 0; padding: 0; width: 100%; max-width: 1180px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px clamp(24px, 2.5vw, 36px); text-align: left; }
  .items li { display: flex; flex-direction: column; }
  .items p { margin: 0; }
  .ico { width: 32px; height: 32px; margin-bottom: 14px; border-radius: 50%; display: grid; place-items: center; background: var(--v-ink); color: var(--v-glyph); }
  .ico :global(svg) { width: 18px; height: 18px; display: block; }
  .name { color: var(--v-ink); }
  .d { margin-top: 4px !important; font-size: 15px; line-height: 1.45; color: var(--v-muted); }

  .more { display: inline-flex; align-items: center; gap: 1px; margin-top: clamp(40px, 5vw, 56px); font-size: 17px; font-weight: 500; text-decoration: none; color: var(--v-ink); }
  .more :global(svg) { width: 20px; height: 20px; display: block; transition: transform 0.2s var(--ease); }
  .more:hover { text-decoration: underline; text-underline-offset: 4px; }
  .more:hover :global(svg) { transform: translateX(2px); }

  @media (max-width: 1100px) { .items { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 640px; } }
  @media (max-width: 560px) { .items { grid-template-columns: minmax(0, 1fr); } }
</style>
