---
/**
 * A Safari window, as in the hero and the closer: traffic lights, then equal tabs (on phones, just the tabs). The open tab is a raised
 * tile; others sit flat on the bar in the secondary colour, with hairlines between them. With `tablist`
 * the tabs are buttons that switch panels (Hero.astro does the switching); otherwise it's one open tab.
 * The window's contents go in the slot.
 */
/** `cycle`: a picture whose open tab follows the story's steps: tab 1 at steps 0–2, tab 2 at step 3, tab 3 at step 4. */
interface Props { tabs: { ai: string; icon: string }[]; tablist?: string; id?: string; cycle?: boolean }
const { tabs, tablist, id = 'tab', cycle = false } = Astro.props;
---
<div class="window">
  <div class="bar" aria-hidden={tablist ? undefined : 'true'}>
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <div class="tabs" role={tablist ? 'tablist' : undefined} aria-label={tablist}>
      {tabs.map((x, i) => {
        const fav = x.icon.endsWith('-color')
          ? <img class="fav" src={`/providers/${x.icon}.svg`} alt="" width="14" height="14" />
          : <span class="fav mono" style={`--fav: url(/providers/${x.icon}.svg)`} />;
        return tablist ? (
          <button type="button" role="tab" class="tab t-foot" id={`${id}-tab-${i}`} aria-controls={`${id}-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            {fav}<span class="tab-t">{x.ai}</span>
          </button>
        ) : (
          <span class:list={['tab t-foot', cycle ? `cyc cyc-${i}` : 'on']}>{fav}<span class="tab-t">{x.ai}</span></span>
        );
      })}
    </div>
  </div>
  <slot />
</div>

<style>
  .window { overflow: hidden; border-radius: 20px; background: var(--cell); color: var(--label); box-shadow: var(--shadow); text-align: left; }
  .bar { display: flex; align-items: center; gap: 12px; height: 42px; padding: 0 7px 0 14px; background: var(--fill); }
  .lights { flex: none; display: inline-flex; gap: 6px; }
  .lights i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  .tabs { --tab-w: 33.333%; position: relative; flex: 1; min-width: 0; display: flex; }
  /* Switchable tabs share one raised tile that slides to the chosen tab, like a segmented control (Hero.astro sets --sel). */
  .tabs[role='tablist']::before { content: ''; position: absolute; top: 0; left: 0; width: var(--tab-w); height: 28px; border-radius: 8px; background: var(--cell); box-shadow: 0 0 0 0.5px var(--hairline), 0 1px 2px rgb(0 0 0 / 0.08); transform: translateX(calc(var(--sel, 0) * 100%)); transition: transform var(--t-open) var(--ease); }
  .tab { position: relative; flex: 0 0 var(--tab-w); min-width: 0; display: flex; align-items: center; justify-content: center; gap: 6px; height: 28px; padding: 0 8px; border: 0; border-radius: 8px; background: none; color: var(--label-2); font-family: inherit; cursor: pointer; }
  .tab + .tab::before { content: ''; position: absolute; left: 0; top: 7px; bottom: 7px; width: 1px; background: var(--hairline); transition: opacity var(--t-fade) var(--ease); }
  /* A window with one open tab sizes it to its name, so it never cuts "Claude" short on a narrow phone. */
  .tab.on:only-child { flex: 0 0 auto; padding: 0 12px; }
  .tab.on { background: var(--cell); box-shadow: 0 0 0 0.5px var(--hairline), 0 1px 2px rgb(0 0 0 / 0.08); }
  .tab.cyc { transition: background-color 0.6s var(--ease), box-shadow 0.6s var(--ease), color 0.6s var(--ease); }
  :global([data-step='0']) .cyc-0, :global([data-step='1']) .cyc-0, :global([data-step='2']) .cyc-0, :global([data-step='3']) .cyc-1, :global([data-step='4']) .cyc-2 { background: var(--cell); box-shadow: 0 0 0 0.5px var(--hairline), 0 1px 2px rgb(0 0 0 / 0.08); color: var(--label); }
  .tab.on, .tab[aria-selected='true'] { color: var(--label); cursor: default; }
  .tab[aria-selected='true']::before, .tab[aria-selected='true'] + .tab::before { opacity: 0; }
  @media (hover: hover) {
    .tab[aria-selected='false']:hover { background: var(--fill); }
    .tab:hover::before, .tab:hover + .tab::before { opacity: 0; }
  }
  .tab-t { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fav { flex: none; display: block; width: 14px; height: 14px; }
  .mono { background: currentColor; mask: var(--fav) center / contain no-repeat; }
  .tab[aria-selected='false'] .fav { opacity: 0.7; }
  /* Each switchable tab answers taps across the bar's full height and a little below it: 44px, while the tile
     itself stays 28px. The focus ring is drawn inside the tab, so nothing around it can clip it. */
  button.tab::after { content: ''; position: absolute; left: 0; right: 0; top: -7px; bottom: -9px; }
  button.tab:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; border-radius: 8px; }
  /* Below 768px the hero draws the preview at 92% (Hero.astro), so the area grows to 48px to stay 44px on screen. */
  @media (max-width: 767px) { button.tab::after { bottom: -13px; } }
  /* On phones the window keeps its controls, a little smaller, and the three tabs share the rest of the bar as
     equal segments, all in full view. */
  @media (max-width: 480px) {
    .bar:has([role='tablist']) { padding: 0 7px 0 10px; gap: 8px; }
    .bar:has([role='tablist']) .lights { gap: 5px; }
    .bar:has([role='tablist']) .lights i { width: 8px; height: 8px; }
    .tabs[role='tablist'] .tab { gap: 4px; padding: 0 3px; }
  }
  /* The story's three-tab window gets the same room-making on phones; only its open tab keeps an icon. */
  @media (max-width: 480px) {
    .bar:has(.cyc) { padding: 0 7px 0 10px; gap: 8px; }
    .bar:has(.cyc) .lights { gap: 5px; }
    .bar:has(.cyc) .lights i { width: 8px; height: 8px; }
    .tab.cyc { gap: 4px; padding: 0 3px; }
    .tab.cyc .fav { display: none; }
    :global([data-step='0']) .cyc-0 .fav, :global([data-step='1']) .cyc-0 .fav, :global([data-step='2']) .cyc-0 .fav, :global([data-step='3']) .cyc-1 .fav, :global([data-step='4']) .cyc-2 .fav { display: block; }
  }
  @media (max-width: 400px) { :global([data-step]) .tab.cyc .fav { display: none; } }
  /* The narrowest phones: only the open tab keeps its icon, so every name fits in full. */
  @media (max-width: 360px) {
    .tabs[role='tablist'] .tab[aria-selected='false'] .fav { display: none; }
  }
</style>
