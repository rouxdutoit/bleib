---
import Mark from './Mark.astro';
import Rails from './Rails.astro';
import { icon, type IconName } from './icons';
import { GITHUB_URL, routes, t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).hero;
const pv = t(lang).preview;
const githubHref = GITHUB_URL || routes.developers[lang];
---
<section class="hero has-rails" aria-labelledby="hero-title">
  <Rails top={false} />
  <div class="wrap hero-inner">
    <p class="eyebrow">{s.eyebrow}</p>
    <h1 id="hero-title" class="hero-h1"><span>{s.h1a}</span> <span>{s.h1b}</span></h1>
    <p class="sub">{s.sub}</p>
    <div class="cta">
      <a class="btn btn-primary" href="#early-access">{s.primary}</a>
      <a class="btn btn-secondary" href={githubHref}>{s.secondary}</a>
    </div>
    <p class="note">{s.note}</p>

    <figure class="preview">
      <div class="window card">
        <div class="bar">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="bar-title t-foot"><span class="mm" aria-hidden="true"><Mark size={10} /></span>{pv.file}</span>
          <span class="lights ghost" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <div class="body">
          <p class="t-foot c-2 pv-eyebrow">{pv.eyebrow}</p>
          <h2 class="t-title2 pv-title">{pv.title}</h2>
          <ul class="tiles">
            {pv.tiles.map((tile) => (
              <li class="tile">
                <span class="t-foot c-2">{tile.label}</span>
                <span class="t-large">{tile.n}</span>
                <span class="t-foot c-2">{tile.note}</span>
              </li>
            ))}
          </ul>
          <div class="split">
            <div class="list-pane">
              <p class="t-foot c-2 pv-eyebrow">{pv.rowsLabel}</p>
              <ul class="rows">
                {pv.rows.map((r, i) => (
                  <li class:list={['row', { selected: i === 0 }]}>
                    <img src={r.icon} alt="" width="32" height="32" />
                    <div class="r-main">
                      <p class="r-top"><span class="t-headline">{r.who}</span><span class="t-foot c-2">{r.when}</span></p>
                      <p class="chips">{r.kinds.map((k) => <span class="chip t-foot"><span set:html={icon(k.icon as IconName)} />{k.label}</span>)}</p>
                      <p class="t-sub c-2">{r.where} · {r.why}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
            <div class="ins-pane">
            <p class="t-foot c-2 pv-eyebrow">{pv.inspector.label}</p>
            <div class="inspector">
              <div class="ins-head">
                <p class="t-title3 ins-title">{pv.inspector.title}</p>
                <span class="ver t-foot"><span set:html={icon('verified')} />{pv.inspector.verified}</span>
              </div>
              <dl class="facts">
                {pv.inspector.facts.map((f) => (<div class="fact"><dt class="t-sub c-2">{f.k}</dt><dd class="t-sub">{f.v}</dd></div>))}
              </dl>
              <p class="t-foot c-2 pv-eyebrow ex-label">{pv.inspector.exactLabel}</p>
              <ul class="exact">{pv.inspector.exact.map((x) => <li><span class="yes" set:html={icon('check')} /><span class="t-body">{x}</span></li>)}</ul>
              <p class="t-foot c-2 not"><span class="not-i" set:html={icon('lock')} />{pv.inspector.notShared}</p>
              <p class="t-foot fp"><span class="fp-i c-2" set:html={icon('fingerprint')} /><code class="c-2">{pv.inspector.fingerprint}</code></p>
            </div>
            </div>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero { padding: clamp(120px, 16vh, 168px) 0 clamp(64px, 9vw, 120px); }
  .hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .eyebrow { margin: 0 0 18px; font-size: 15px; font-weight: 500; color: var(--muted); }
  .hero-h1 { font-size: clamp(38px, 5.4vw, 64px); font-weight: 600; line-height: 1.07; letter-spacing: -0.03em; max-width: 22ch; text-wrap: balance; }
  .hero-h1 span { display: inline-block; }
  .sub { margin: 22px 0 0; font-size: clamp(17px, 1.6vw, 19px); line-height: 1.5; color: var(--muted); max-width: 40em; text-wrap: balance; }
  .cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 30px; }
  .note { margin: 18px 0 0; font-size: 14px; color: var(--muted); }

  .preview { margin: clamp(48px, 7vw, 80px) 0 0; width: 100%; max-width: 980px; text-align: left; }
  .window { overflow: hidden; border-radius: 22px; box-shadow: var(--shadow); }
  /* macOS window chrome: traffic lights left, title centred. */
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 44px; padding: 0 16px; border-bottom: 1px solid var(--hairline); }
  .lights { display: inline-flex; gap: 8px; }
  .lights i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.12); }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  .lights.ghost { visibility: hidden; justify-self: end; }
  .bar-title { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--label-2); }
  .mm { width: 16px; height: 16px; border-radius: 4px; display: grid; place-items: center; background: #0a0a0a; color: #f6e79a; }
  .body { padding: 24px; }
  .pv-eyebrow { margin: 0; font-weight: 600; }
  .pv-title { margin: 2px 0 16px; }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .tile { display: grid; gap: 2px; padding: 14px 16px; border-radius: 16px; background: var(--fill); }
  .list-pane .pv-eyebrow, .ins-pane .pv-eyebrow { height: 18px; margin-bottom: 8px; }
  .rows { list-style: none; margin: 0; padding: 0; }
  /* Split view (Mail / App Privacy Report): list with category capsules, inspector for the selected receipt. */
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 16px; margin-top: 24px; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row { display: flex; align-items: flex-start; gap: 12px; padding: 10px 10px; border-radius: 14px; position: relative; }
  .row + .row::before { content: ''; position: absolute; top: 0; right: 10px; left: 54px; height: 1px; background: var(--hairline); }
  /* macOS selection: solid accent rounded rect, white text; separators hide next to it. */
  .row.selected { background: var(--sel); color: var(--sel-ink); }
  .row.selected .c-2 { color: var(--sel-ink-2); }
  .row.selected .chip { background: var(--sel-chip); color: var(--sel-chip-ink); }
  .row.selected + .row::before { display: none; }
  .row img { flex: none; margin-top: 2px; border-radius: 8px; background: var(--fill); padding: 5px; }
  .row.selected img { background: var(--cell); }
  .r-main { flex: 1; min-width: 0; }
  .r-main p { margin: 0; }
  .r-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .r-top .t-foot { white-space: nowrap; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 3px !important; }
  .chip { display: inline-flex; align-items: center; gap: 4px; padding: 2px 9px 2px 7px; border-radius: 999px; background: #f6e79a; color: #0a0a0a; font-weight: 600; }
  .chip :global(svg) { width: 14px; height: 14px; }
  .inspector { border-radius: 16px; background: var(--fill); padding: 16px 18px; }
  .inspector p { margin: 0; }
  .ins-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .ins-title { margin: 0 !important; }
  .facts { margin: 0; }
  .fact { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-top: 1px solid var(--hairline); }
  .fact dd { margin: 0; text-align: right; }
  .ex-label { margin-top: 14px !important; }
  /* Same pattern as the story receipt: one grouped list, yellow ticks, hairlines between rows. */
  .exact { list-style: none; margin: 6px 0 0; padding: 0; border-radius: 12px; background: var(--cell); }
  .exact li { position: relative; display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 12px; }
  .exact li + li::before { content: ''; position: absolute; top: 0; right: 0; left: 44px; height: 1px; background: var(--hairline); }
  .yes { flex: none; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; background: #f6e79a; color: #0a0a0a; }
  .yes :global(svg) { width: 15px; height: 15px; display: block; }
  .not { margin-top: 10px !important; display: flex; align-items: center; gap: 5px; }
  .not-i :global(svg) { width: 13px; height: 13px; display: block; }
  .fp { margin-top: 12px !important; display: flex; align-items: center; gap: 6px; }
  .fp-i :global(svg) { width: 16px; height: 16px; display: block; }
  .fp code { font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 12px; }
  .ver { flex: none; display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px 3px 7px; border-radius: 999px; background: color-mix(in srgb, var(--ok) 16%, transparent); color: #1f8a3a; font-weight: 600; }
  :global(:root[data-theme='dark']) .ver { color: var(--ok); }
  .ver :global(svg) { width: 15px; height: 15px; display: block; }

  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .tiles { grid-template-columns: 1fr; }
  }
</style>
<style is:global>
  :root[data-theme='dark'] .hero .row img { background: #f5f1e6; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .hero .row img { background: #f5f1e6; }
  }
</style>
