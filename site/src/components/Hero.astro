---
import Mark from './Mark.astro';
import DrawTick from './DrawTick.astro';
import Rails from './Rails.astro';
import { icon, type IconName } from './icons';
import { GITHUB_URL, routes, t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).hero;
const pv = t(lang).preview;
const githubHref = GITHUB_URL || routes.developers[lang];
---
<section class="hero has-rails" aria-labelledby="hero-title">
  <Rails top={false} />
  <div class="wrap hero-inner">
    <p class="eyebrow">{s.eyebrow}</p>
    <h1 id="hero-title" class="hero-h1"><span>{s.h1a}</span> <span>{s.h1b}</span></h1>
    <p class="sub">{s.sub.map((line) => <span>{line}</span>)}</p>
    <div class="cta">
      <a class="btn btn-primary" href="#early-access">{s.primary}</a>
      <a class="btn btn-secondary" href={githubHref}>{s.secondary}</a>
    </div>
    <ul class="trust t-foot">
      {s.trust.map((x) => <li><span set:html={icon(x.icon as IconName)} />{x.t}</li>)}
    </ul>

    <figure class="preview">
      <div class="window card">
        <div class="bar">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="tabs" role="tablist" aria-label={pv.examples}>
            {pv.tabs.map((x, i) => (
              <button type="button" role="tab" class="tab t-foot" id={`ex-tab-${i}`} aria-controls={`ex-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                {x.icon.endsWith('-color')
                  ? <img class="fav" src={`/providers/${x.icon}.svg`} alt="" width="14" height="14" />
                  : <span class="fav mono" style={`--fav: url(/providers/${x.icon}.svg)`} />}
                <span class="tab-t">{x.ai}</span>
              </button>
            ))}
          </div>
        </div>
        {pv.tabs.map((x, i) => {
          const title = pv.title.replace('{ai}', x.ai);
          return (
            <div class="body" role="tabpanel" id={`ex-${i}`} aria-labelledby={`ex-tab-${i}`} hidden={i !== 0} data-steps="3" data-interval="800" data-gaps=",2600" data-step="0" {...(i === 0 ? { 'data-sv': '' } : {})}>
              <p class="sr-only">{x.typed} {title}: {x.facts.join(', ')}. {x.private}</p>
              <div aria-hidden="true">
                <div class="grow"><div class="grow-in">
                  <div class="fill">
                    <p class="fill-head"><span class="app"><Mark size={12} /></span><span class="t-foot fill-title">{title}</span></p>
                    <div class="fill-row">
                      <ul class="facts">{x.facts.map((f) => <li class="t-sub"><span class="yes" set:html={icon('check')} />{f}</li>)}</ul>
                      <span class="b"><span class="to-add">{pv.add}</span><span class="to-added"><span class="tick"><DrawTick /></span>{pv.added}</span></span>
                    </div>
                  </div>
                </div></div>
                <div class="composer">
                  <div class="attach"><div class="grow-in">
                    <div class="chip">
                      <span class="app chip-app"><Mark size={14} /></span>
                      <span class="chip-text"><span class="t-foot chip-title">{pv.attachment}</span><span class="t-foot chip-facts">{x.facts.join(' · ')}</span></span>
                      <span class="chip-x" set:html={icon('close')} />
                    </div>
                  </div></div>
                  <p class="t-body input"><span class="field"><span data-type={x.typed}>{x.typed}</span><span class="caret"></span></span><span class="send" set:html={icon('arrow_outward')} /></p>
                </div>
                <p class="t-foot private"><span class="lock" set:html={icon('lock')} />{x.private}</p>
              </div>
            </div>
          );
        })}
      </div>
    </figure>
  </div>
</section>

<style>
  .hero { padding: clamp(120px, 16vh, 168px) 0 clamp(64px, 9vw, 120px); }
  .hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .eyebrow { margin: 0 0 18px; font-size: 15px; font-weight: 500; color: var(--muted); }
  .hero-h1 { font-size: clamp(38px, 5.4vw, 64px); font-weight: 600; line-height: 1.07; letter-spacing: -0.03em; max-width: 22ch; text-wrap: balance; }
  .hero-h1 span { display: block; }
  .sub { margin: 22px 0 0; font-size: clamp(17px, 1.6vw, 19px); line-height: 1.5; color: var(--muted); max-width: 40em; text-wrap: balance; }
  .cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 30px; }
  .sub span { display: block; }
  .trust { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; color: var(--muted); }
  .trust li { display: inline-flex; align-items: center; gap: 6px; }
  .trust :global(svg) { width: 15px; height: 15px; display: block; }

  /* The fill moment: a new AI, bleib offers only what it needs, like a password manager filling a login.
     Plays once in view (scripts/story.ts); each tab is another everyday example and replays when chosen. */
  .preview { margin: clamp(40px, 6vw, 72px) 0 0; width: 100%; max-width: 520px; text-align: left; }
  .window { overflow: hidden; border-radius: 20px; box-shadow: var(--shadow); }
  /* A Safari window: traffic lights, then equal tabs. The open tab is a raised tile; the others sit flat
     on the bar in the secondary colour, with hairlines between them. Switching is instant, as in Safari. */
  .bar { display: flex; align-items: center; gap: 12px; height: 42px; padding: 0 7px 0 14px; background: var(--fill); }
  .lights { flex: none; display: inline-flex; gap: 6px; }
  .lights i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  .tabs { flex: 1; min-width: 0; display: flex; }
  .tab { position: relative; flex: 1 1 0; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 6px; height: 28px; padding: 0 8px; border: 0; border-radius: 8px; background: none; color: var(--label-2); font-family: inherit; cursor: pointer; }
  .tab + .tab::before { content: ''; position: absolute; left: 0; top: 7px; bottom: 7px; width: 1px; background: var(--hairline); }
  .tab[aria-selected='true'] { background: var(--cell); color: var(--label); box-shadow: 0 0 0 0.5px var(--hairline), 0 1px 2px rgb(0 0 0 / 0.08); cursor: default; }
  .tab[aria-selected='true']::before, .tab[aria-selected='true'] + .tab::before { opacity: 0; }
  @media (hover: hover) {
    .tab[aria-selected='false']:hover { background: var(--fill); }
    .tab:hover::before, .tab:hover + .tab::before { opacity: 0; }
  }
  .tab-t { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fav { flex: none; display: block; width: 14px; height: 14px; }
  .mono { background: currentColor; mask: var(--fav) center / contain no-repeat; }
  .tab[aria-selected='false'] .fav { opacity: 0.7; }
  .body { padding: 16px; }
  .body p { margin: 0; }

  .grow { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 0.55s var(--ease), opacity 0.4s var(--ease) 0.12s; }
  .grow-in { min-height: 0; overflow: hidden; }
  .s2 .grow { grid-template-rows: 1fr; opacity: 1; }
  .fill { margin-bottom: 8px; padding: 10px 12px 12px; border-radius: 14px; background: var(--fill); }
  .fill-head { display: flex; align-items: center; gap: 8px; }
  .app { flex: none; width: 22px; height: 22px; border-radius: 6px; display: grid; place-items: center; background: #0a0a0a; color: #f6e79a; }
  .fill-title { color: var(--label-2); }
  .fill-row { margin-top: 8px; display: flex; align-items: center; gap: 12px; }
  .facts { flex: 1; min-width: 0; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .facts li { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .yes { flex: none; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: #f6e79a; color: #0a0a0a; }
  .yes :global(svg) { width: 13px; height: 13px; display: block; }

  /* Like the story cards: the action in the label colour, bleib yellow once done; labels crossfade in place. */
  .b { flex: none; display: inline-grid; place-items: center; height: 28px; padding: 0 12px; border-radius: 999px; font-size: 13px; line-height: 1; font-weight: 600; background: var(--label); color: var(--cell); transition: background-color 0.35s var(--ease), color 0.35s var(--ease); }
  .b > span { grid-area: 1 / 1; transition: opacity 0.35s var(--ease); }
  .to-added { display: inline-flex; align-items: center; gap: 4px; opacity: 0; }
  .s3 .b { background: #f6e79a; color: #0a0a0a; }
  .s3 .to-add { opacity: 0; }
  .s3 .to-added { opacity: 1; }
  .tick { display: grid; }

  /* The message box. Once added, your memory sits in it as an attachment, like pasted text in a chat app. */
  .composer { border-radius: 22px; box-shadow: inset 0 0 0 1px var(--hairline); }
  .input { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 8px 8px 16px; }
  .attach { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 0.5s var(--ease) 0.2s, opacity 0.4s var(--ease) 0.3s; }
  .s3 .attach { grid-template-rows: 1fr; opacity: 1; }
  .chip { position: relative; display: flex; align-items: center; gap: 10px; width: fit-content; max-width: calc(100% - 16px); margin: 8px 8px 0; padding: 8px 30px 8px 8px; border-radius: 14px; background: var(--fill); }
  .chip-app { width: 32px; height: 32px; border-radius: 8px; }
  .chip-text { min-width: 0; display: flex; flex-direction: column; }
  .chip-title { font-weight: 600; color: var(--label); }
  .chip-facts { color: var(--label-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chip-x { position: absolute; top: -6px; right: -6px; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; background: var(--label); color: var(--cell); }
  .chip-x :global(svg) { width: 13px; height: 13px; display: block; }
  /* Typed out at step 1 (scripts/story.ts), with a macOS text caret that blinks once focused. */
  .field { flex: 1; min-width: 0; }
  .caret { display: inline-block; width: 2px; height: 1.15em; margin-left: 1px; vertical-align: -0.2em; border-radius: 1px; background: var(--label); opacity: 0; }
  .s1 .caret { opacity: 1; animation: caret 1.06s steps(1, end) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .send { flex: none; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--fill); color: var(--label-2); }
  .send :global(svg) { width: 16px; height: 16px; display: block; transform: rotate(-45deg); }
  /* A standing promise, not a step: there from the start, centred under the field. */
  .private { margin-top: 10px !important; display: flex; align-items: center; justify-content: center; gap: 6px; color: var(--label-2); }
  .lock :global(svg) { width: 13px; height: 13px; display: block; }
  @media (max-width: 767px) { .preview { zoom: 0.92; } }
  /* Like Safari on a phone: no window controls, so the tabs get the room. */
  @media (max-width: 480px) { .lights { display: none; } .bar { padding-left: 7px; } }
</style>

<script>
  import { play, reset } from '../scripts/story';
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.preview [role="tab"]')];
  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (!panel || panel.hidden !== on) continue;
      panel.hidden = !on;
      if (on) play(panel);
      else reset(panel);
    }
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (to === undefined) return;
      e.preventDefault();
      const next = tabs[(to + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>
