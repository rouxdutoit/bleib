---
import Mark from './Mark.astro';
import Rails from './Rails.astro';
import { icon, type IconName } from './icons';
import { GITHUB_URL, routes, t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).hero;
const pv = t(lang).preview;
const githubHref = GITHUB_URL || routes.developers[lang];
---
<section class="hero has-rails" aria-labelledby="hero-title">
  <Rails top={false} />
  <div class="wrap hero-inner">
    <p class="eyebrow">{s.eyebrow}</p>
    <h1 id="hero-title" class="hero-h1"><span>{s.h1a}</span> <span>{s.h1b}</span></h1>
    <p class="sub">{s.sub.map((line) => <span>{line}</span>)}</p>
    <div class="cta">
      <a class="btn btn-primary" href="#early-access">{s.primary}</a>
      <a class="btn btn-secondary" href={githubHref}>{s.secondary}</a>
    </div>
    <ul class="trust t-foot">
      {s.trust.map((x) => <li><span set:html={icon(x.icon as IconName)} />{x.t}</li>)}
    </ul>

    <figure class="preview">
      <div class="window card">
        <div class="bar">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="bar-title t-foot"><span class="mm" aria-hidden="true"><Mark size={10} /></span>{pv.file}</span>
          <span class="lights ghost" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <div class="body">
          <h2 class="t-title2 pv-title">{pv.title}</h2>
          <ul class="rows">
            {pv.rows.map((r) => (
              <li class="row">
                <img src={r.icon} alt="" width="32" height="32" />
                <div class="r-main">
                  <p class="r-top"><span class="t-headline">{r.who}</span><span class="t-foot c-2">{r.when}</span></p>
                  <p class="t-foot c-2 r-where">{r.where}</p>
                  <ul class="saw">{r.saw.map((x) => <li><span class="yes" set:html={icon('check')} /><span class="t-sub">{x}</span></li>)}</ul>
                </div>
              </li>
            ))}
          </ul>
          <p class="t-foot c-2 not"><span class="not-i" set:html={icon('lock')} />{pv.footer}</p>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero { padding: clamp(120px, 16vh, 168px) 0 clamp(64px, 9vw, 120px); }
  .hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .eyebrow { margin: 0 0 18px; font-size: 15px; font-weight: 500; color: var(--muted); }
  .hero-h1 { font-size: clamp(38px, 5.4vw, 64px); font-weight: 600; line-height: 1.07; letter-spacing: -0.03em; max-width: 22ch; text-wrap: balance; }
  .hero-h1 span { display: block; }
  .sub { margin: 22px 0 0; font-size: clamp(17px, 1.6vw, 19px); line-height: 1.5; color: var(--muted); max-width: 40em; text-wrap: balance; }
  .cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 30px; }
  .sub span { display: block; }
  .trust { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; color: var(--muted); }
  .trust li { display: inline-flex; align-items: center; gap: 6px; }
  .trust :global(svg) { width: 15px; height: 15px; display: block; }

  .preview { margin: clamp(48px, 7vw, 80px) 0 0; width: 100%; max-width: 560px; text-align: left; }
  .window { overflow: hidden; border-radius: 22px; box-shadow: var(--shadow); }
  /* macOS window chrome: traffic lights left, title centred. */
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 44px; padding: 0 16px; border-bottom: 1px solid var(--hairline); }
  .lights { display: inline-flex; gap: 8px; }
  .lights i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.12); }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  .lights.ghost { visibility: hidden; justify-self: end; }
  .bar-title { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--label-2); }
  .mm { width: 16px; height: 16px; border-radius: 4px; display: grid; place-items: center; background: #0a0a0a; color: #f6e79a; }
  .body { padding: 20px 24px 22px; }
  .pv-title { margin: 0 0 8px; }
  /* One idea: each AI, and exactly what it was given. */
  .rows { list-style: none; margin: 0; padding: 0; }
  .row { display: flex; align-items: flex-start; gap: 12px; padding: 14px 0; position: relative; }
  .row + .row::before { content: ''; position: absolute; top: 0; right: 0; left: 44px; height: 1px; background: var(--hairline); }
  .row img { flex: none; margin-top: 2px; border-radius: 8px; background: var(--fill); padding: 5px; }
  .r-main { flex: 1; min-width: 0; }
  .r-main p { margin: 0; }
  .r-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .r-top .t-foot { white-space: nowrap; }
  .saw { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .saw li { display: inline-flex; align-items: center; gap: 7px; }
  .yes { flex: none; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: #f6e79a; color: #0a0a0a; }
  .yes :global(svg) { width: 13px; height: 13px; display: block; }
  .not { margin: 6px 0 0 !important; padding-top: 14px; border-top: 1px solid var(--hairline); display: flex; align-items: center; gap: 6px; }
  .not-i :global(svg) { width: 13px; height: 13px; display: block; }
</style>
<style is:global>
  :root[data-theme='dark'] .hero .row img { background: #f5f1e6; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .hero .row img { background: #f5f1e6; }
  }
</style>
