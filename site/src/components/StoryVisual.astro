---
/**
 * One tray per scene. The tray never moves; the card inside morphs step by step to act out
 * the scene's headline (Rule No. 1: Apple HIG patterns throughout). It plays once when seen.
 * Every card reads top to bottom as cause, then result, so the eye ends on the outcome.
 * Steps are driven by scripts/story.ts: it sets data-step="n" and cumulative classes s1..sn.
 *   .at-N     collapsed until step N, then open
 *   .dim-N    greys out at step N (nothing ever disappears, so the progression stays readable)
 *   .pick-at-N  capsule turns prominent at step N
 */
import Mark from './Mark.astro';
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang; scene: number }
const { lang, scene } = Astro.props;
const c = t(lang).cards;
const STEPS = [4, 3, 4, 6, 3];
const INTERVAL = [900, 900, 900, 620, 900];

import { icon, type IconName } from './icons';
const svg = (name: string, cls = 'g') => icon(name as IconName, cls);
const cx = (n: number) => `cx at-${n}`;
---
<div class="sv" data-sv data-steps={STEPS[scene]} data-interval={INTERVAL[scene]} data-step="0">
  <div class="tray">
    <div class="stack" aria-hidden="true">
      {scene === 0 && (
        <>
          <div>
            <div>
              <div class="sources">
                <p class="t-foot c-2 src-h">{c.wallet.sourcesLabel}</p>
                <ul class="src-list">
                  {c.wallet.sources.map((m, i) => (
                    <li class={`dim-${i + 1}`}><div class="src-item"><div class="card mini"><span class="t-foot c-2 from">{m.from}</span><span class="t-sub">{m.text}</span></div></div></li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
          <div class="card list-card">
            <p class="head"><span class="t-headline">{c.wallet.title}</span><span class="t-sub c-2 cnt">{[0, 1, 2, 3, 4].map((n) => <span class={`c${n}`}>{n}</span>)}</span></p>
            <ul class="group">
              {c.wallet.rows.map((r, i) => (
                <li class={cx(i + 1)}>
                  <div class="cx-in"><div class="cell">
                    <span class="ico" set:html={svg(r.icon)} />
                    <span class="t-body cell-k">{r.k}</span>
                    <span class="t-body c-2 cell-v">{r.locked && <span class="inline-g" set:html={svg('lock')} />}{r.v}</span>
                  </div></div>
                </li>
              ))}
            </ul>
            <p class="t-foot c-2 sec-f"><span class="inline-g" set:html={svg('lock')} />{c.wallet.footer}</p>
          </div>
        </>
      )}

      {scene === 1 && (
        <>
          <div class="dim-2">
            <div>
              <div class="card alert">
                <p class="t-headline">{c.ask.title}</p>
                <p class="t-foot msg">{c.ask.message}</p>
                <div class="pills">
                  <span class="pill t-body pick-at-1">{c.ask.action}</span>
                </div>
              </div>
            </div>
          </div>
          <div class={cx(2)}>
            <div class="cx-in">
              <div class="card list-card">
                <p class="t-foot c-2 sec-h">{c.ask.rulesLabel}</p>
                <div class="cell">
                  <img class="app-sm" src="/providers/claude.svg" alt="" width="29" height="29" />
                  <span class="cell-k"><span class="t-body">{c.ask.rule.who}</span><span class="t-sub c-2 blk">{c.ask.rule.kind}</span></span>
                  <span class="t-body c-2">{c.ask.rule.scope}</span>
                </div>
              </div>
            </div>
          </div>
          <div class={cx(3)}>
            <div class="cx-in">
              <div class="card note">
                <div class="note-head">
                  <span class="ok" set:html={svg('check')} />
                  <div class="note-id"><p class="t-headline">{c.ask.later.title}</p><p class="t-sub c-2">{c.ask.later.sub}</p></div>
                </div>
              </div>
            </div>
          </div>
        </>
      )}

      {scene === 2 && (
        <>
          <div class="card note">
            <div class="note-head">
              <img class="app" src="/providers/claude.svg" alt="" width="38" height="38" />
              <div class="note-id"><p class="t-headline">{c.receipt.who}</p><p class="t-sub c-2">{c.receipt.where}</p></div>
              <p class="t-foot c-2">{c.receipt.time}</p>
            </div>
            <p class="t-sub c-2 purpose">{c.receipt.purposeLabel} {c.receipt.purpose}</p>
            <p class="t-foot c-2 sec-h inner">{c.receipt.sharedLabel}</p>
            <ul class="group filled">
              {c.receipt.shared.map((x, i) => (
                <li class={cx(i + 1)}><div class="cx-in"><div class="cell"><span class="yes" set:html={svg('check')} /><span class="t-body">{x}</span></div></div></li>
              ))}
            </ul>
            <div class={cx(3)}><div class="cx-in"><p class="t-foot c-2 not"><span class="inline-g" set:html={svg('lock')} />{c.receipt.notShared}</p></div></div>
          </div>
          <div class={cx(4)}>
            <div class="cx-in">
              <div class="card widget">
                <p class="t-foot c-2 w-label"><span class="w-mark" aria-hidden="true"><Mark size={11} /></span>{c.receipt.weeklyLabel}</p>
                <p class="w-num"><span class="t-large">{c.receipt.weeklyN}</span><span class="t-sub">{c.receipt.weeklyText}</span></p>
                <p class="t-foot c-2 w-note"><span class="inline-g ok-g" set:html={svg('verified_user')} />{c.receipt.weeklyNote}</p>
              </div>
            </div>
          </div>
        </>
      )}

      {scene === 3 && (
        <>
          <div class="card list-card">
            <div class="head-cell">
              <span class="w-tile" aria-hidden="true"><Mark size={18} /></span>
              <div>
                <p class="t-headline">{c.any.title}</p>
                <p class="t-sub c-2">{c.any.sub}</p>
              </div>
            </div>
            <ul class="group">
              {c.wallet.rows.slice(0, 3).map((r) => (
                <li class="cell"><span class="ico" set:html={svg(r.icon)} /><span class="t-body cell-k">{r.k}</span><span class="t-body c-2 cell-v">{r.v}</span></li>
              ))}
            </ul>
            <p class="t-foot c-2 used">{c.any.usedBy} <span class="swap">{c.any.providers.map((p, i) => <span class={`u${i}`}>{p.name}</span>)}</span></p>
          </div>
          <div class="card strip">
            <div class="pwin">
              <div class="ptrack">
                {c.any.providers.map((p, i) => (
                  <span class={`pi pi-${i}`}>
                    <span class="picon">
                      <img class="pm" src={p.icon} alt="" width="28" height="28" draggable="false" />
                      {p.color && <img class="pc" src={p.color} alt="" width="28" height="28" draggable="false" />}
                    </span>
                    <span class="t-foot pname">{p.name}</span>
                  </span>
                ))}
                <span class="pi">
                  <span class="picon pmore"><i></i><i></i><i></i></span>
                  <span class="t-foot pname">{c.any.more}</span>
                </span>
              </div>
            </div>
            <p class="t-foot c-2 strip-cap">{c.any.caption}</p>
          </div>
        </>
      )}

      {scene === 4 && (
        <>
          <div class="dim-2">
            <div>
              <div class="card note">
                <div class="note-head">
                  <img class="app" src="/providers/claude.svg" alt="" width="38" height="38" />
                  <div class="note-id"><p class="t-headline">{c.propose.title}</p><p class="t-sub c-2">{c.propose.app}</p></div>
                  <p class="t-foot c-2">{c.propose.time}</p>
                </div>
                <p class="t-body fact">{c.propose.fact}</p>
                <p class="t-foot c-2">{c.propose.why}</p>
                <div class="pills">
                  <span class="pill t-body pick-at-1">{c.propose.save}</span>
                </div>
              </div>
            </div>
          </div>
          <div class="card list-card">
            <p class="t-foot c-2 sec-h">{c.propose.walletLabel}</p>
            <ul class="group">
              {c.wallet.rows.slice(0, 2).map((r) => (
                <li class="cell"><span class="ico" set:html={svg(r.icon)} /><span class="t-body cell-k">{r.k}</span><span class="t-body c-2 cell-v">{r.v}</span></li>
              ))}
              <li class={cx(2)}>
                <div class="cx-in"><div class="cell">
                  <span class="ico" set:html={svg('person')} />
                  <span class="cell-k"><span class="t-body">{c.propose.newRow.v}</span></span>
                  <span class="tag t-foot">{c.propose.newTag}</span>
                </div></div>
              </li>
            </ul>
            <div class={cx(3)}><div class="cx-in"><p class="t-foot c-2 sec-f"><span class="inline-g" set:html={svg('lock')} />{c.propose.saved}</p></div></div>
          </div>
        </>
      )}
    </div>
  </div>
</div>

<style>
  .sv { width: 100%; }
  /* Cards are pictures of the product: on phones and short screens they shrink so the finished card fits in view. */
  @media (max-width: 767px) { .sv { zoom: 0.86; } }
  @media (min-width: 768px) and (max-height: 760px) { .sv { zoom: 0.9; } }
  .sv p { margin: 0; }
  .tray { position: relative; }
  .stack { display: flex; flex-direction: column; gap: 12px; }

  /* Collapsible pieces: height and opacity morph in place, nothing jumps. */
  .cx { display: grid; grid-template-rows: 0fr; opacity: 0; margin-top: -12px; transition: grid-template-rows 0.55s var(--ease), opacity 0.4s var(--ease) 0.12s, margin-top 0.55s var(--ease); }
  .card { transform: translateZ(0); backface-visibility: hidden; }
  li.cx, .card .cx { margin-top: 0; }
  .cx-in { overflow: hidden; min-height: 0; }
  .s1 .at-1, .s2 .at-2, .s3 .at-3, .s4 .at-4, .s5 .at-5 { grid-template-rows: 1fr; opacity: 1; margin-top: 0; }

  /* Done steps stay in place and grey out. */
  [class*='dim-'] { transition: opacity 0.45s var(--ease); }
  .s1 .dim-1, .s2 .dim-2, .s3 .dim-3, .s4 .dim-4, .s5 .dim-5 { opacity: 0.38; }

  /* Lists (Settings) */
  .list-card { padding: 14px 0 12px; }
  .head { display: flex; align-items: baseline; gap: 8px; padding: 0 16px 6px; }
  .cnt span { display: none; }
  [data-step='0'] .cnt .c0, [data-step='1'] .cnt .c1, [data-step='2'] .cnt .c2, [data-step='3'] .cnt .c3, [data-step='4'] .cnt .c4, [data-step='5'] .cnt .c4 { display: inline; }
  .sec-h { padding: 0 16px 6px; font-weight: 600; }
  .sec-h.inner { padding: 14px 0 6px; }
  .sec-f { padding: 8px 16px 0; display: flex; align-items: center; justify-content: center; gap: 5px; }
  .group { list-style: none; margin: 0; padding: 0; }
  .cell { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 16px; position: relative; }
  .group > li + li .cell::before, .group > li.cell + li.cell::before, .group > li.cell + li .cell::before { content: ''; position: absolute; top: 0; right: 0; left: 57px; height: 1px; background: var(--hairline); }
  .ico { flex: none; width: 29px; height: 29px; border-radius: 7px; display: grid; place-items: center; background: var(--fill); color: var(--label); }
  .ico :global(.g) { width: 17px; height: 17px; }
  .cell-k { flex: 1; min-width: 0; }
  .blk { display: block; }
  .cell-v { text-align: right; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
  .inline-g { display: inline-flex; }
  .inline-g :global(.g) { width: 13px; height: 13px; }
  .head-cell { display: flex; align-items: center; gap: 12px; padding: 2px 16px 4px; }
  .w-tile { width: 44px; height: 44px; border-radius: 11px; display: grid; place-items: center; background: #0a0a0a; color: #f6e79a; flex: none; }
  .used { padding: 8px 16px 0; }
  .swap span { display: none; color: var(--label); font-weight: 600; }
  [data-step='0'] .swap .u0, [data-step='1'] .swap .u1, [data-step='2'] .swap .u2, [data-step='3'] .swap .u3,
  [data-step='4'] .swap .u4, [data-step='5'] .swap .u5, [data-step='6'] .swap .u6 { display: inline; }

  /* Provider strip: models step past; the wallet above never moves. */
  .strip { padding: 14px 0 12px; }
  .pwin { width: 330px; max-width: 100%; margin: 0 auto; overflow: hidden; -webkit-mask-image: linear-gradient(to right, transparent, #000 26%, #000 74%, transparent); mask-image: linear-gradient(to right, transparent, #000 26%, #000 74%, transparent); }
  .ptrack { display: flex; width: max-content; padding-left: 110px; transform: translateX(calc(var(--i, 0) * -110px)); transition: transform 0.55s var(--ease); }
  [data-step='1'] .ptrack { --i: 1; } [data-step='2'] .ptrack { --i: 2; } [data-step='3'] .ptrack { --i: 3; }
  [data-step='4'] .ptrack { --i: 4; } [data-step='5'] .ptrack { --i: 5; } [data-step='6'] .ptrack { --i: 6; }
  .pi { flex: 0 0 110px; display: flex; flex-direction: column; align-items: center; gap: 6px; height: 64px; justify-content: center; }
  .picon { position: relative; width: 28px; height: 28px; }
  .picon img { position: absolute; inset: 0; width: 28px; height: 28px; object-fit: contain; transition: opacity 0.4s var(--ease); }
  .pm { opacity: 0.25; }
  /* The strip doesn't end on the last model: a greyed "More" follows, and never becomes active. */
  .pmore { display: flex; align-items: center; justify-content: center; gap: 3px; opacity: 0.25; }
  .pmore i { width: 5px; height: 5px; border-radius: 50%; background: var(--label); }
  .pc { opacity: 0; }
  .pname { color: var(--label-3); transition: color 0.4s var(--ease); }
  [data-step='0'] .pi-0 .pc, [data-step='1'] .pi-1 .pc, [data-step='2'] .pi-2 .pc, [data-step='3'] .pi-3 .pc,
  [data-step='4'] .pi-4 .pc, [data-step='5'] .pi-5 .pc { opacity: 1; }
  [data-step='0'] .pi-0 .pm, [data-step='1'] .pi-1 .pm, [data-step='2'] .pi-2 .pm, [data-step='3'] .pi-3 .pm,
  [data-step='4'] .pi-4 .pm, [data-step='5'] .pi-5 .pm { opacity: 0; }
  [data-step='6'] .pi-6 .pm { opacity: 1; }
  [data-step='0'] .pi-0 .pname, [data-step='1'] .pi-1 .pname, [data-step='2'] .pi-2 .pname, [data-step='3'] .pi-3 .pname,
  [data-step='4'] .pi-4 .pname, [data-step='5'] .pi-5 .pname, [data-step='6'] .pi-6 .pname { color: var(--label); font-weight: 600; }
  .strip-cap { padding: 6px 16px 0; text-align: center; }
  .tag { padding: 2px 8px; border-radius: 999px; background: #f6e79a; color: #0a0a0a; font-weight: 600; }

  /* Sources tray (like a stack of notifications) */
  /* Sources: a stack that shrinks as each item moves up into the wallet. */
  .sources { border-radius: 22px; background: var(--fill); padding: 12px; }
  .src-h { padding: 0 4px 8px; }
  /* Two by two: four scattered facts read at a glance, at half the height of a list. */
  .src-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .src-item, .mini { height: 100%; }
  .mini { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border-radius: 14px; }

  /* Alert */
  .alert { padding: 22px 16px 16px; text-align: center; }
  .msg { margin-top: 4px !important; }
  .pills { display: grid; gap: 8px; margin-top: 18px; }
  .pill { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 12px; border-radius: 999px; background: var(--fill); color: var(--label); font-weight: 500; transition: background-color 0.35s var(--ease), color 0.35s var(--ease); }
  .s1 .pick-at-1 { background: var(--label); color: var(--cell); }

  /* Notification */
  .note { padding: 14px 16px 16px; }
  .note-head { display: flex; align-items: center; gap: 10px; }
  .note-id { flex: 1; min-width: 0; }
  .app { width: 38px; height: 38px; border-radius: 9px; padding: 6px; background: var(--fill); flex: none; }
  .app-sm { width: 29px; height: 29px; border-radius: 7px; padding: 4px; background: var(--fill); flex: none; }
  .purpose { margin-top: 12px !important; }
  .group.filled { background: var(--fill); border-radius: 12px; }
  .group.filled .cell { padding: 0 12px; }
  .group.filled > li + li .cell::before { left: 44px; }
  .yes { flex: none; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; background: #f6e79a; color: #0a0a0a; }
  .yes :global(.g) { width: 15px; height: 15px; }
  .ok :global(.g) { width: 18px; height: 18px; }
  .ok { flex: none; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--ok); color: #fff; }
  .not { padding-top: 10px; display: flex; align-items: center; gap: 5px; }
  .fact { margin-top: 12px !important; font-weight: 500; }

  /* Widget */
  .widget { padding: 14px 16px 16px; }
  .w-label { display: flex; align-items: center; gap: 6px; font-weight: 600; }
  .w-mark { width: 18px; height: 18px; border-radius: 5px; display: grid; place-items: center; background: #0a0a0a; color: #f6e79a; }
  .w-num { display: flex; align-items: baseline; gap: 8px; margin-top: 6px !important; }
  .w-note { margin-top: 6px !important; display: flex; align-items: center; gap: 5px; }
  .ok-g { color: var(--ok); }


</style>
<style is:global>
  :root[data-theme='dark'] .sv .app,
  :root[data-theme='dark'] .sv .app-sm { background: #f5f1e6; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .sv .app,
    :root:not([data-theme='light']) .sv .app-sm { background: #f5f1e6; }
    :root:not([data-theme='light']) .sv .pm { filter: invert(1); }
  }
  :root[data-theme='dark'] .sv .pm { filter: invert(1); }
  :root[data-theme='dark'] .sv .w-tile,
  :root[data-theme='dark'] .sv .w-mark { box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14); }
</style>
