---
/**
 * Each card morphs step by step to act out
 * the scene's headline (Rule No. 1: Apple HIG patterns throughout). It plays once when seen.
 * Every card reads top to bottom as cause, then result, so the eye ends on the outcome.
 * Steps are driven by scripts/story.ts: it sets data-step="n" and cumulative classes s1..sn.
 * Moves come from the motion kit in global.css (Reveal, Crossfade, Settle via .at-N and .dim-N);
 *   .pick-at-N  a choice is pressed at step N and turns bleib yellow, done
 */
import DrawTick from './DrawTick.astro';
import Window from './Window.astro';
import BleibCard from './BleibCard.astro';
import Composer from './Composer.astro';
import ProviderLogo from './ProviderLogo.astro';
import { t, type Lang } from '../i18n/strings';
/** `tray` puts scene 6's card on the yellow tray too, as on the subpages (on the homepage it sits on the black band). */
interface Props { lang: Lang; scene: number; tray?: boolean }
const { lang, scene, tray = false } = Astro.props;
const c = t(lang).cards;
const STEPS = [4, 3, c.any.providers.length - 1, 2, 2, 1];
const INTERVAL = [900, 900, 1250, 900, 900, 1000];
/** Reading time: before step 1, the card as it first appears; GAPS, what a step reveals (see scripts/story.ts). */
const START = [900, 1000, 2200, 1500, 1000, 1600];
const GAPS = ['', ',900', '', '2200', '900', ''];

import { icon, type IconName } from './icons';
const svg = (name: string, cls = 'g') => icon(name as IconName, cls);
const cx = (n: number) => `reveal at-${n}`;
/** What plays the steps (scripts/story.ts) and holds the finished height (scripts/reserve.js). Scene 2 is a chat window,
 *  so, as in the hero, the window's body plays and holds it, and the message box never moves. */
const play = { 'data-sv': '', 'data-steps': STEPS[scene], 'data-interval': INTERVAL[scene], 'data-start': START[scene], 'data-gaps': GAPS[scene] || undefined, 'data-step': '0' };
const chat = scene === 1;
---
<div class="sv" {...(chat ? {} : play)}>
  <div class={scene === 5 && !tray ? undefined : 'tray'}>
    <div class="stack" aria-hidden="true">
      {scene === 0 && (
        /* One list fills up: each detail arrives from the AI that had it, so "scattered" shows in the rows themselves. */
        <div class="card list-card import-card">
          <p class="head"><span class="t-headline">{c.wallet.title}</span><span class="t-sub c-2 cnt">{[0, 1, 2, 3, 4].map((n) => <span class={`c${n}`}>{n}</span>)}</span></p>
          <ul class="group">
            {c.wallet.rows.map((r, i) => (
              <li class={cx(i + 1)}>
                <div class="reveal-in"><div class="cell">
                  <span class="ico ico-2" set:html={svg(r.icon)} />
                  <span class="cell-k"><span class="t-body">{r.k}</span><span class="t-sub c-2 from">{c.wallet.fromLabel} <ProviderLogo name={r.from} lang={lang} /><span class="from-n">{r.from}</span></span></span>
                  <span class="t-body c-2 cell-v">{r.locked && <span class="inline-g" set:html={svg('lock')} />}{r.v}</span>
                </div></div>
              </li>
            ))}
          </ul>
          <p class="t-foot c-2 sec-f"><span class="inline-g" set:html={svg('lock')} />{c.wallet.footer}</p>
        </div>
      )}

      {scene === 1 && (
        <Window tabs={[{ ai: c.propose.app, icon: 'claude-color' }]}>
          {/* Like the hero: you type, you send, and bleib's card says it's saved; the pill's × takes it out again (scripts/story.ts). */}
          <div class="chat" {...play}>
            <p class="t-body bubble appear at-2">{c.propose.said}</p>
            <BleibCard title={c.propose.title} facts={[{ t: c.propose.fact, icon: 'translate' }]} at={3} removable />
            <Composer typed={c.propose.said} sentAt={2} />
          </div>
        </Window>
      )}

      {scene === 2 && (
        <>
          <div class="card list-card">
            <p class="head"><span class="t-headline">{c.wallet.title}</span><span class="t-sub c-2">3</span></p>
            <ul class="group">
              {c.wallet.rows.slice(0, 3).map((r) => (
                <li class="cell"><span class="ico" set:html={svg(r.icon)} /><span class="t-body cell-k">{r.k}</span><span class="t-body c-2 cell-v">{r.v}</span></li>
              ))}
            </ul>
            <p class="t-foot c-2 used">{c.any.usedBy} <span class="swap">{c.any.providers.map((p, i) => <span class={`u${i}`}><ProviderLogo name={p.name} lang={lang} size={12} /> {p.name}</span>)}</span></p>
          </div>
          <div class="card strip">
            <div class="pwin">
              <div class="ptrack">
                {c.any.providers.map((p, i) => (
                  <span class={`pi pi-${i}`}>
                    <span class="picon">
                      <img class="pm" src={p.icon} alt="" width="28" height="28" draggable="false" />
                      {p.color && <img class="pc" src={p.color} alt="" width="28" height="28" draggable="false" />}
                    </span>
                    <span class="t-foot pname">{p.name}</span>
                  </span>
                ))}
              </div>
            </div>
            <p class="t-foot c-2 strip-cap">{c.any.caption}</p>
          </div>
        </>
      )}

      {scene === 3 && (
        <>
          {/* Everyday things just work, then something sensitive asks first. */}
          <div class="card note">
            <div class="note-head">
              {(() => { const p = c.any.providers.find((x) => x.name === c.ask.later.ai); return p && <img class="app app-tall" src={p.color || p.icon} alt="" width="50" height="50" />; })()}
              <div class="note-id"><p class="t-headline">{c.ask.later.title}</p><p class="later-fact"><span class="pill-fact t-foot"><span class="pill-sym" set:html={svg(c.ask.later.icon)} />{c.ask.later.sub}</span><span class="t-foot auto">{c.ask.later.tag}</span></p></div>
            </div>
          </div>
          <div class={cx(1)}>
            <div class="reveal-in">
              <div class="card alert">
                <span class="alert-sym" set:html={svg('favorite')} />
                <p class="t-headline">{c.ask.title}</p>
                <p class="t-foot msg">{c.ask.message}</p>
                <div class="pills">
                  <span class="pill t-body crossfade press pick-at-2 at-2"><span>{c.ask.action}</span><span class="done"><span class="tick"><DrawTick /></span>{c.ask.allowed}</span></span>
                </div>
              </div>
            </div>
          </div>
        </>
      )}

      {scene === 4 && (
        /* One receipt, like a notification: who and what for, the details shared as pills (they land one by one), and
           what stayed private. */
        <div class="card note">
          <div class="note-head">
            <img class="app" src="/providers/claude-color.svg" alt="" width="42" height="42" />
            <div class="note-id"><p class="t-headline">{c.receipt.title}</p><p class="t-sub c-2">{c.receipt.purpose}</p></div>
            <p class="t-foot c-2 time">{c.receipt.time}</p>
          </div>
          <p class="receipt-facts">{c.receipt.shared.map((x, i) => (
            <span class={`pill-fact t-foot appear land at-${i + 1}`}><span class="pill-sym" set:html={svg(x.icon)} />{x.t}</span>
          ))}</p>
          <p class="t-foot c-2 not"><span class="inline-g" set:html={svg('lock')} />{c.receipt.notShared}</p>
        </div>
      )}

      {scene === 5 && (
        <div class="card list-card switch-card">
          <ul class="group">
            {c.any.providers.map((p, i) => (
              <li class="cell">
                <img class="app" src={p.color || p.icon} alt="" width="42" height="42" />
                <span class="cell-k"><span class="t-body">{p.name}</span><span class="t-sub c-2 blk">{c.off.setting}</span></span>
                <span class="toggle at-1" style={`--delay: ${i * 0.35}s`} />
              </li>
            ))}
          </ul>
          <p class="t-foot c-2 sec-f"><span class="inline-g" set:html={svg('lock')} />{c.off.note}</p>
        </div>
      )}
    </div>
  </div>
</div>

<style>
  .sv { width: 100%; }
  /* Cards are pictures of the product: on phones and short screens they shrink so the finished card fits in view. */
  @media (max-width: 767px) { .sv { zoom: 0.86; } }
  @media (min-width: 768px) and (max-height: 760px) { .sv { zoom: 0.9; } }
  .sv p { margin: 0; }
  .tray { position: relative; }
  .stack { display: flex; flex-direction: column; gap: 12px; }

  /* Collapsible pieces: height and opacity morph in place, nothing jumps. */
  /* A reveal in the stack also closes the stack's gap until it opens. */
  .stack > .reveal { margin-top: -12px; transition-property: grid-template-rows, opacity, margin-top; }
  .s1 .stack > .at-1, .s2 .stack > .at-2, .s3 .stack > .at-3, .s4 .stack > .at-4, .s5 .stack > .at-5 { margin-top: 0; }
  .card { transform: translateZ(0); backface-visibility: hidden; }

  /* Done steps stay in place and grey out. */

  /* Lists (Settings) */
  .list-card { padding: 14px 0 12px; }
  .head { display: flex; align-items: baseline; gap: 8px; padding: 0 16px 6px; }
  /* Every memory card has the same heading: the title, then how many groups it holds. */
  .cnt span { display: none; }
  [data-step='0'] .cnt .c0, [data-step='1'] .cnt .c1, [data-step='2'] .cnt .c2, [data-step='3'] .cnt .c3, [data-step='4'] .cnt .c4, [data-step='5'] .cnt .c4 { display: inline; }
  .sec-h { padding: 0 16px 6px; font-weight: 600; }
  .sec-h.inner { padding: 14px 0 6px; }
  /* Each AI's own memory switch, as it sits in that AI's settings. */
  .switch-card .cell { min-height: 56px; }
  .sec-f { padding: 8px 16px 0; display: flex; align-items: center; justify-content: center; gap: 5px; }
  .group { list-style: none; margin: 0; padding: 0; }
  /* A border, not a 1px box: phones always draw it, even on the slightly scaled-down cards. */
  .cell { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 16px; position: relative; }
  .group > li + li .cell::before, .group > li.cell + li.cell::before, .group > li.cell + li .cell::before { content: ''; position: absolute; top: 0; right: 0; left: 57px; border-top: 1px solid var(--hairline); }
  .ico { flex: none; width: 29px; height: 29px; border-radius: 7px; display: grid; place-items: center; background: var(--fill); color: var(--label); }
  .ico :global(.g) { width: 17px; height: 17px; }
  /* Beside two lines of text (a title and a detail), the icon is as tall as both, as in Apple's lists. */
  .ico-2 { width: 42px; height: 42px; border-radius: 10px; }
  .ico-2 :global(.g) { width: 22px; height: 22px; }
  .cell-k { flex: 1; min-width: 0; }
  .cell-k > .t-body { display: block; }
  .blk { display: block; }
  .cell-v { flex: none; text-align: right; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
  /* On a narrow phone the value keeps its room; the title and source shorten with an ellipsis instead of overlapping. */
  .cell-k > .t-body, .from-n { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .from-n { min-width: 0; }
  .inline-g { display: inline-flex; }
  .inline-g :global(.g) { width: 13px; height: 13px; }
  .used { padding: 8px 16px 0; }
  /* The provider's name crossfades in step with the strip. */
  .swap { display: inline-grid; }
  .swap span { grid-area: 1 / 1; opacity: 0; color: var(--label); font-weight: 600; transition: opacity var(--t-fade) var(--ease); }
  [data-step='0'] .swap .u0, [data-step='1'] .swap .u1, [data-step='2'] .swap .u2 { opacity: 1; }

  /* Provider strip: models step past; the wallet above never moves. */
  .strip { padding: 14px 0 12px; }
  .pwin { width: 330px; max-width: 100%; margin: 0 auto; overflow: hidden; -webkit-mask-image: linear-gradient(to right, transparent, #000 26%, #000 74%, transparent); mask-image: linear-gradient(to right, transparent, #000 26%, #000 74%, transparent); }
  .ptrack { display: flex; width: max-content; position: relative; left: calc(50% - 55px); transform: translateX(calc(var(--i, 0) * -110px)); transition: transform var(--t-open) var(--ease); }
  [data-step='1'] .ptrack { --i: 1; } [data-step='2'] .ptrack { --i: 2; }
  .pi { flex: 0 0 110px; display: flex; flex-direction: column; align-items: center; gap: 6px; height: 64px; justify-content: center; }
  .picon { position: relative; width: 28px; height: 28px; }
  .picon img { position: absolute; inset: 0; width: 28px; height: 28px; object-fit: contain; transition: opacity var(--t-fade) var(--ease); }
  .pm { opacity: 0.25; }
  .pc { opacity: 0; }
  .pname { color: var(--label-3); transition: color var(--t-fade) var(--ease); }
  [data-step='0'] .pi-0 .pc, [data-step='1'] .pi-1 .pc, [data-step='2'] .pi-2 .pm { opacity: 1; }
  [data-step='0'] .pi-0 .pm, [data-step='1'] .pi-1 .pm { opacity: 0; }
  [data-step='0'] .pi-0 .pname, [data-step='1'] .pi-1 .pname, [data-step='2'] .pi-2 .pname { color: var(--label); font-weight: 600; }
  .strip-cap { padding: 6px 16px 0; text-align: center; }
  .tag { padding: 2px 8px; border-radius: 999px; background: #f6e79a; color: #0a0a0a; font-weight: 600; }

  /* Scene 1: each row says which AI the detail came from, under its kind. */
  .import-card .cell { min-height: 56px; }
  .from { display: flex; align-items: center; gap: 4px; min-width: 0; white-space: nowrap; }

  /* Alert */
  .alert { padding: 22px 16px 16px; text-align: center; }
  /* Like an Apple alert: the symbol of what it is about above the question; Health is the pink heart. */
  .alert-sym { display: block; width: 30px; height: 30px; margin: 0 auto 10px; color: #ff2d55; }
  .alert-sym :global(svg) { width: 100%; height: 100%; display: block; }
  :root[data-theme='dark'] .alert-sym { color: #ff375f; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .alert-sym { color: #ff375f; } }
  .msg { margin-top: 4px !important; }
  .pills { display: grid; gap: 8px; margin-top: 18px; }
  .pill { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 12px; border-radius: 999px; background: var(--fill); color: var(--label); font-weight: 500; transition: background-color var(--t-fade) var(--ease), color var(--t-fade) var(--ease); }
  /* Like Added: the pressed choice crossfades to its done label and turns bleib yellow as a tick draws. */
  .pill.crossfade { display: grid; place-items: center; }
  .done { display: inline-flex; align-items: center; gap: 6px; }
  .tick { display: grid; }
  .tick :global(.draw-tick) { width: 16px; height: 16px; }
  .s2 .pick-at-2 { background: #f6e79a; color: #0a0a0a; }

  /* Notification */
  .note { padding: 14px 16px 16px; }
  .note-head { display: flex; align-items: center; gap: 10px; }
  .note-id { flex: 1; min-width: 0; }
  /* A quiet status capsule, as iOS marks a state. */
  /* A status, not a detail: plain secondary text like Settings' "Automatic", so it never reads as a second pill. */
  .auto { flex: none; color: var(--label-2); }
  /* An AI's icon tile is as tall as the two lines of text beside it (title and detail). */
  .app { width: 42px; height: 42px; border-radius: 10px; padding: 7px; background: var(--fill); flex: none; }
  .app-tall { width: 50px; height: 50px; border-radius: 12px; padding: 9px; }
  /* The detail as a pill, with Automatic at the end of the same line, so the title keeps the full width. */
  .later-fact { margin-top: 4px !important; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .pill-fact { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px 3px 8px; border-radius: 999px; background: var(--fill); color: var(--label); font-weight: 500; }
  .pill-sym { display: grid; color: var(--label-2); }
  .pill-sym :global(.g) { width: 14px; height: 14px; }
  /* Receipt: the shared details line up with the title, the private note sits under them. */
  .time { align-self: flex-start; }
  .receipt-facts { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0 52px !important; }
  .not { padding: 10px 0 0 52px; display: flex; align-items: center; gap: 5px; }

  /* Quiet saving */
  /* Scene 2: a chat window, as in the hero. The message lands just after send is pressed. */
  .chat { --bleib-card-margin: 0 0 8px; display: flex; flex-direction: column; justify-content: flex-end; padding: 16px; }
  /* Nothing in the window ever shrinks to make room, so the message, bleib's card and the box can never overlap. */
  .chat > :global(*) { flex: none; }
  /* .sv p resets margins, so the bubble names .sv too, or it would sit right on bleib's card. */
  .sv .bubble { --delay: 0.15s; align-self: flex-end; max-width: 80%; margin: 0 0 12px; padding: 8px 14px; border-radius: 18px; background: var(--fill); }
  /* Like the hero card: a saved detail is a pill with its own symbol. */



</style>
<style is:global>
  :root[data-theme='dark'] .sv .app { background: #f5f1e6; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .sv .app { background: #f5f1e6; }
    :root:not([data-theme='light']) .sv .pm { filter: invert(1); }
  }
  :root[data-theme='dark'] .sv .pm { filter: invert(1); }
  :root[data-theme='dark'] .sv .w-mark { box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14); }
</style>
