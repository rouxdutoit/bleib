---
/**
 * Each card morphs step by step to act out
 * the scene's headline (Rule No. 1: Apple HIG patterns throughout). It plays once when seen.
 * Every card reads top to bottom as cause, then result, so the eye ends on the outcome.
 * Steps are driven by scripts/story.ts: it sets data-step="n" and cumulative classes s1..sn.
 * Moves come from the motion kit in global.css (Reveal, Crossfade, Settle via .at-N and .dim-N);
 *   .pick-at-N  a choice is pressed at step N and turns bleib yellow, done
 */
import DrawTick from './DrawTick.astro';
import Window from './Window.astro';
import BleibCard from './BleibCard.astro';
import Composer from './Composer.astro';
import ProviderLogo from './ProviderLogo.astro';
import Mark from './Mark.astro';
import { t, type Lang } from '../i18n/strings';
/** `tray` puts scene 6's card on the yellow tray too, as on the subpages (on the homepage it sits on the black band). */
interface Props { lang: Lang; scene: number; tray?: boolean }
const { lang, scene, tray = false } = Astro.props;
const c = t(lang).cards;
const STEPS = [5, 3, c.any.providers.length - 1, 2, 2, 3];
const INTERVAL = [900, 900, 1700, 900, 900, 1000];
/** Reading time: before step 1, the card as it first appears; GAPS, what a step reveals (see scripts/story.ts). */
const START = [900, 1000, 2200, 1500, 1000, 1600];
const GAPS = ['', ',900', '', '1400', '', ''];

import { icon, type IconName } from './icons';
const svg = (name: string, cls = 'g') => icon(name as IconName, cls);
/** Scene 1: what each value looks like sealed, before bleib opens it on this device. */
const CIPHER = ['9f2c·71ab', 'e04d·5a3e', '3b8f·c26d', 'a71e·0d94'];
const cx = (n: number) => `reveal at-${n}`;
/** What plays the steps (scripts/story.ts) and holds the finished height (scripts/reserve.js). Scene 2 is a chat window,
 *  so, as in the hero, the window's body plays and holds it, and the message box never moves. */
const play = { 'data-sv': '', 'data-steps': STEPS[scene], 'data-interval': INTERVAL[scene], 'data-start': START[scene], 'data-gaps': GAPS[scene] || undefined, 'data-step': '0' };
const chat = scene === 1;
/** What each finished card shows, in words, for screen readers (the card itself is a hidden picture). */
const names = c.any.providers.map((p) => p.name).join(', ');
const caption = [
  `${c.wallet.title}: ${c.wallet.rows.map((r) => `${r.k}, ${r.v}, ${c.wallet.fromLabel} ${r.from}`).join('; ')}. ${c.wallet.footer}`,
  `${c.propose.app}: “${c.propose.said}” ${c.propose.title}: ${c.propose.fact}.`,
  `${c.any.providers.map((p, i) => `${p.name}: “${c.any.drafts[i]}” ${t(lang).preview.attachment}: ${c.propose.fact}`).join('. ')}. ${c.any.caption}`,
  `${c.wallet.title}: ${c.need.rows.map((r) => `${r.k}, ${r.v}`).join('; ')}. ${c.need.draft} ${t(lang).preview.attachment}: ${c.need.rows.filter((r) => r.use).map((r) => r.v).join(', ')}. ${c.need.rows.filter((r) => r.locked).map((r) => r.k).join('')}: ${c.need.asks}.`,
  `${c.receipt.title}, ${c.receipt.time}. ${c.receipt.purpose}. ${c.receipt.shared.map((x) => x.t).join(', ')}. ${c.receipt.notShared}.`,
  `${c.off.imported}, ${c.off.from}. ${names}: ${c.off.setting} off. ${c.off.note}`,
][scene];
---
<div class="sv" {...(chat ? {} : play)}>
  <div class={scene === 5 && !tray ? undefined : 'tray'}>
    <p class="sr-only">{caption}</p>
    <div class="stack" aria-hidden="true">
      {scene === 0 && (
        /* One list fills up: each detail arrives from the AI that had it, sealed (it is stored encrypted), then bleib opens
           it for you on this device, and the padlock in the footer closes. */
        <div class="card list-card import-card">
          <p class="head"><span class="t-headline">{c.wallet.title}</span><span class="t-sub c-2 cnt">{[0, 1, 2, 3, 4].map((n) => <span class={`c${n}`}>{n}</span>)}</span></p>
          <ul class="group">
            {c.wallet.rows.map((r, i) => (
              <li class={cx(i + 1)}>
                <div class="reveal-in"><div class="cell">
                  <span class="ico ico-2" set:html={svg(r.icon)} />
                  <span class="cell-k"><span class="t-body">{r.k}</span><span class="t-sub c-2 from"><span class="from-l">{c.wallet.fromLabel} </span><ProviderLogo name={r.from} lang={lang} /><span class="from-n">{r.from}</span></span></span>
                  <span class="t-body c-2 cell-v crossfade at-5"><span class="ciph">{CIPHER[i]}</span><span class="plain">{r.locked && <span class="inline-g" set:html={svg('lock')} />}{r.v}</span></span>
                </div></div>
              </li>
            ))}
          </ul>
          <p class="t-foot c-2 sec-f seal"><span class="inline-g" set:html={svg('lock')} />{c.wallet.footer}</p>
        </div>
      )}

      {scene === 1 && (
        <Window tabs={[{ ai: c.propose.app, icon: 'claude-color' }]}>
          {/* Like the hero: you type, you send, and bleib's card says it's saved; the pill's × takes it out again (scripts/story.ts). */}
          <div class="chat" {...play}>
            {/* bleib's card appears above the message, in space the window already holds, so the message never moves. */}
            <BleibCard title={c.propose.title} facts={[{ t: c.propose.fact, icon: c.propose.icon }]} at={3} removable />
            <p class="t-body bubble appear at-2">{c.propose.said}</p>
            <Composer typed={c.propose.said} sentAt={2} />
          </div>
        </Window>
      )}

      {scene === 2 && (
        /* One memory, every AI: the window's tabs move from Claude to Gemini to ChatGPT; each gets a different request,
           and the same bleib chip lands in every draft. The row under it lights the AI that's open. */
        <>
          <Window tabs={c.any.providers.map((p) => ({ ai: p.name, icon: p.color ? p.color.replace('/providers/', '').replace('.svg', '') : 'openai' }))} cycle>
            <div class="xs">
              {c.any.providers.map((_, i) => (
                <div class={`xp xp-${i}`}>
                  <div class="yc att"><p class="yc-h"><span class="yc-tile"><Mark size={12} /></span><span class="t-foot yc-t">{t(lang).preview.title.replace('{ai}', c.any.providers[i].name)}</span></p><p class="yc-pills"><span class="ycp t-foot"><span class="ycs" set:html={svg(c.propose.icon)} />{c.propose.fact}</span></p></div>
                  <div class="xbox"><p class="t-body xdraft">{c.any.drafts[i]}</p></div>
                </div>
              ))}
            </div>
          </Window>
          <div class="card reach">
            <p class="reach-row">{c.any.providers.map((p, i) => (
              <span class={`rc rc-${i}`}><img class:list={['rlogo', { mono: !p.color }]} src={p.color || p.icon} alt="" width="22" height="22" /><span class="t-foot">{p.name}</span></span>
            ))}</p>
            <p class="t-foot c-2 reach-cap">{c.any.caption}</p>
          </div>
        </>
      )}

      {scene === 3 && (
        /* Only what it needs: your whole memory is there, but for a Lisbon weekend only the seat and the diet light up and go
           into the draft; work stays put, and health is locked and asks first. */
        <>
          <div class="card list-card need-card">
            <p class="head"><span class="t-headline">{c.wallet.title}</span></p>
            <ul class="group">
              {c.need.rows.map((r) => (
                <li class:list={['cell', r.use ? 'use' : r.locked ? 'held' : 'dim-1']}>
                  <span class="ico" set:html={svg(r.icon)} />
                  <span class="t-body cell-k">{r.k}</span>
                  <span class="t-body c-2 cell-v">{r.locked ? <span class="crossfade at-1"><span>{<span class="inline-g" set:html={svg('lock')} />}{r.v}</span><span class="asks">{c.need.asks}</span></span> : r.v}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="card need-draft">
            <div class={cx(2)}><div class="reveal-in">
              <div class="yc"><p class="yc-h"><span class="yc-tile"><Mark size={12} /></span><span class="t-foot yc-t">{t(lang).preview.title.replace('{ai}', 'ChatGPT')}</span></p><p class="yc-pills">{c.need.rows.filter((r) => r.use).map((r) => <span class="ycp t-foot"><span class="ycs" set:html={svg(r.icon === 'flight' ? 'airline_seat' : r.icon)} />{r.v}</span>)}</p></div>
            </div></div>
            <p class="t-body xdraft">{c.need.draft}</p>
          </div>
        </>
      )}

      {scene === 4 && (
        /* One receipt, like a notification: who and what for, then the details that went, one by one, and last what
           stayed private: the proof. */
        <div class="card note">
          <div class="note-head">
            <span class="app ntile"><Mark size={22} /></span>
            <div class="note-id"><p class="t-headline">{c.receipt.title}</p><p class="t-sub c-2">{c.receipt.purpose}</p></div>
            <p class="t-foot c-2 time">{c.receipt.time}</p>
          </div>
          <p class="receipt-facts">{c.receipt.shared.map((x, i) => (
            <span class="pill-fact t-foot appear at-1" style={`--delay: ${i * 0.25}s`}><span class="pill-sym" set:html={svg(x.icon)} />{x.t}</span>
          ))}</p>
          <p class="t-foot c-2 not appear at-2"><span class="inline-g" set:html={svg('lock')} />{c.receipt.notShared}</p>
        </div>
      )}

      {scene === 5 && (
        /* Import first, then switch off. bleib's row ends in a capsule the size of the switches below, like the App
           Store's Get button: its download symbol fills with a progress ring and becomes a centred tick; then each AI's
           own Memory switch goes off. */
        <div class="card list-card switch-card">
          <ul class="group">
            <li class="cell imp">
              <span class="btile"><Mark size={20} /></span>
              <span class="cell-k"><span class="t-body crossfade at-2 ttl"><span>{c.off.import}</span><span>{c.off.imported}</span></span><span class="t-sub c-2 blk">{c.off.from}</span></span>
              <span class="get">
                <span class="crossfade at-1">
                  <span class="dl" set:html={svg('download')} />
                  <span class="crossfade at-2">
                    <svg class="ring" viewBox="0 0 24 24" aria-hidden="true"><circle class="track" cx="12" cy="12" r="8.5" /><circle class="prog" cx="12" cy="12" r="8.5" pathLength="1" /></svg>
                    <span class="tk"><DrawTick /></span>
                  </span>
                </span>
              </span>
            </li>
            {c.any.providers.map((p, i) => (
              <li class="cell">
                <img class:list={['app', { mono: !p.color }]} src={p.color || p.icon} alt="" width="42" height="42" />
                <span class="cell-k"><span class="t-body">{p.name}</span><span class="t-sub c-2 blk">{c.off.setting}</span></span>
                <span class="toggle at-3" style={`--delay: ${i * 0.35}s`} />
              </li>
            ))}
          </ul>
          <p class="t-foot c-2 sec-f"><span class="inline-g" set:html={svg('lock')} />{c.off.note}</p>
        </div>
      )}
    </div>
  </div>
</div>

<style>
  .sv { width: 100%; }
  /* Cards are pictures of the product: on phones and short screens they shrink so the finished card fits in view. */
  @media (max-width: 767px) { .sv { zoom: 0.86; } }
  @media (min-width: 768px) and (max-height: 760px) { .sv { zoom: 0.9; } }
  .sv p { margin: 0; }
  .tray { position: relative; }
  .stack { display: flex; flex-direction: column; gap: 12px; }

  /* Collapsible pieces: height and opacity morph in place, nothing jumps. */
  /* A reveal in the stack also closes the stack's gap until it opens. */
  .stack > .reveal { margin-top: -12px; transition-property: grid-template-rows, opacity, margin-top; }
  .s1 .stack > .at-1, .s2 .stack > .at-2, .s3 .stack > .at-3, .s4 .stack > .at-4, .s5 .stack > .at-5 { margin-top: 0; }
  .card { transform: translateZ(0); backface-visibility: hidden; }

  /* Done steps stay in place and grey out. */

  /* Lists (Settings) */
  .list-card { padding: 14px 0 12px; }
  .head { display: flex; align-items: baseline; gap: 8px; padding: 0 16px 6px; }
  /* Every memory card has the same heading: the title, then how many groups it holds. */
  .cnt span { display: none; }
  [data-step='0'] .cnt .c0, [data-step='1'] .cnt .c1, [data-step='2'] .cnt .c2, [data-step='3'] .cnt .c3, [data-step='4'] .cnt .c4, [data-step='5'] .cnt .c4 { display: inline; }
  .sec-h { padding: 0 16px 6px; font-weight: 600; }
  .sec-h.inner { padding: 14px 0 6px; }
  /* Each AI's own memory switch, as it sits in that AI's settings. */
  .switch-card .cell { min-height: 56px; }
  /* The Get → progress → done capsule: exactly the switch's size, on the same centre line, its symbol centred. */
  .ttl { display: inline-grid; }
  .get { flex: none; margin-inline-start: auto; width: 51px; height: 31px; border-radius: 999px; background: var(--fill); color: var(--label); display: grid; place-items: center; }
  .get .crossfade { place-items: center; }
  .dl, .tk { display: grid; }
  .dl :global(svg), .ring, .tk :global(.draw-tick) { width: 18px; height: 18px; display: block; }
  .group > li.imp + li.cell::before { content: ''; position: absolute; top: 0; right: 0; left: 57px; border-top: 1px solid var(--hairline); }
  .btile { flex: none; width: 42px; height: 42px; border-radius: 10px; display: grid; place-items: center; background: #0a0a0a; color: #f6e79a; }
  .ring { transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 2.2; }
  .ring .track { stroke: var(--hairline); }
  .ring .prog { stroke: currentColor; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 0.75s var(--ease) calc(var(--delay, 0s) + 0.1s); }
  :global(.s1) .ring .prog { stroke-dashoffset: 0; }
  .tk :global(path) { stroke-width: 3; }
  .sec-f { padding: 8px 16px 0; display: flex; align-items: center; justify-content: center; gap: 5px; }
  .group { list-style: none; margin: 0; padding: 0; }
  /* A border, not a 1px box: phones always draw it, even on the slightly scaled-down cards. */
  .cell { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 16px; position: relative; }
  .group > li + li .cell::before, .group > li.cell + li.cell::before, .group > li.cell + li .cell::before { content: ''; position: absolute; top: 0; right: 0; left: 57px; border-top: 1px solid var(--hairline); }
  .ico { flex: none; width: 29px; height: 29px; border-radius: 7px; display: grid; place-items: center; background: var(--fill); color: var(--label); }
  .ico :global(.g) { width: 17px; height: 17px; }
  /* Beside two lines of text (a title and a detail), the icon is as tall as both, as in Apple's lists. */
  .ico-2 { width: 42px; height: 42px; border-radius: 10px; }
  .ico-2 :global(.g) { width: 22px; height: 22px; }
  .cell-k { flex: 1; min-width: 0; }
  .cell-k > .t-body { display: block; }
  /* A title that changes (Import → Imported) keeps both words in one place. */
  .cell-k > .t-body.crossfade { display: grid; justify-items: start; }
  .blk { display: block; }
  .cell-v { flex: none; text-align: right; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
  /* On a narrow phone the value keeps its room; the title and source shorten with an ellipsis instead of overlapping. */
  .cell-k > .t-body, .from-n { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .from-n { min-width: 0; }
  /* On the narrowest phones the row keeps the source's logo and name and drops the word “From”. */
  @media (max-width: 360px) { .from-l { display: none; } }
  .inline-g { display: inline-flex; }
  .inline-g :global(.g) { width: 13px; height: 13px; }
  /* Scene 3: one draft per AI, in one place, each shown in turn; the chip lands a beat after its tab opens. */
  .xs { display: grid; padding: 14px; }
  .xp { grid-area: 1 / 1; opacity: 0; transition: opacity var(--t-fade) var(--ease); }
  [data-step='0'] .xp-0, [data-step='1'] .xp-1, [data-step='2'] .xp-2 { opacity: 1; }
  .xbox { border-radius: 22px; box-shadow: inset 0 0 0 1px var(--hairline); padding: 4px 8px 12px; }
  .att { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px 8px 8px; border-radius: 14px; background: var(--fill); opacity: 0; transform: translateY(-6px) scale(0.98); transition: opacity var(--t-fade) var(--ease) 0.45s, transform var(--t-open) var(--spring) 0.45s; }
  [data-step='0'] .xp-0 .att, [data-step='1'] .xp-1 .att, [data-step='2'] .xp-2 .att { opacity: 1; transform: none; }
  /* bleib's own notification, as in the hero: yellow in both themes, black tile, each detail a white pill. */
  .yc { margin-bottom: 8px; padding: 10px 10px 10px 12px; border-radius: 14px; background: #f6e79a; color: #0a0a0a; display: grid; gap: 8px; }
  .yc-h { display: flex; align-items: center; gap: 8px; }
  .yc-tile { flex: none; width: 22px; height: 22px; border-radius: 6px; display: grid; place-items: center; background: #0a0a0a; color: #f6e79a; }
  .yc-t { color: rgba(10, 10, 10, .72); }
  .yc-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .ycp { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px 4px 8px; border-radius: 999px; background: rgba(255, 255, 255, .85); color: #0a0a0a; font-weight: 500; white-space: nowrap; }
  .ycs { display: grid; color: rgba(10, 10, 10, .62); }
  .ycs :global(svg) { width: 14px; height: 14px; display: block; }
  .yc.att { display: grid; padding: 10px 10px 10px 12px; background: #f6e79a; border-radius: 14px; }
  .att-tile { width: 30px; height: 30px; border-radius: 8px; display: grid; place-items: center; background: #0a0a0a; color: #f6e79a; flex: none; }
  .att-t { display: grid; }
  .att-h { font-weight: 600; color: var(--label); }
  .xdraft { margin: 10px 8px 0 !important; }
  /* Scene 1: sealed values in a monospaced face, then the readable value in the same place. */
  .ciph { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 13px; letter-spacing: 0.02em; color: var(--label-3); }
  .cell-v.crossfade { display: inline-grid; justify-items: end; }
  .cell-v .plain { display: inline-flex; align-items: center; gap: 4px; }
  /* Scene 4: the rows a request needs light up in bleib yellow; the rest step back (dim-1); health says it asks first. */
  .need-card .cell.use .ico { background: #f6e79a; color: #0a0a0a; transition: background-color var(--t-fade) var(--ease); }
  .need-card .cell.use .ico { background: var(--fill); color: var(--label); }
  :global(.s1) .need-card .cell.use .ico { background: #f6e79a; color: #0a0a0a; }
  .asks { color: var(--label); font-weight: 600; }
  .need-draft { padding: 12px 14px 14px; }
  .need-draft .att { opacity: 1; transform: none; margin-bottom: 4px; }
  .reach { padding: 14px 16px 12px; }
  .reach-row { display: flex; justify-content: space-around; }
  .rc { display: flex; flex-direction: column; align-items: center; gap: 6px; color: var(--label-3); opacity: 0.45; transition: opacity var(--t-fade) var(--ease) 0.45s, color var(--t-fade) var(--ease) 0.45s, filter var(--t-fade) var(--ease) 0.45s; }
  .rlogo { width: 22px; height: 22px; display: block; }
  /* Only the AI whose tab is open is lit; the others wait in grey. */
  [data-step='0'] .rc-0, [data-step='1'] .rc-1, [data-step='2'] .rc-2 { opacity: 1; color: var(--label); }
  .rc { filter: grayscale(1); }
  [data-step='0'] .rc-0, [data-step='1'] .rc-1, [data-step='2'] .rc-2 { filter: none; }
  .reach-cap { padding-top: 10px; text-align: center; }
  .tag { padding: 2px 8px; border-radius: 999px; background: #f6e79a; color: #0a0a0a; font-weight: 600; }

  /* Scene 1: each row says which AI the detail came from, under its kind. */
  .import-card .cell { min-height: 56px; }
  .from { display: flex; align-items: center; gap: 4px; min-width: 0; white-space: nowrap; }

  /* Alert */
  .alert { padding: 22px 16px 16px; text-align: center; }
  /* Like an Apple alert: the symbol of what it is about above the question; Health is the pink heart. */
  .alert-sym { display: block; width: 30px; height: 30px; margin: 0 auto 10px; color: #ff2d55; }
  .alert-sym :global(svg) { width: 100%; height: 100%; display: block; }
  :root[data-theme='dark'] .alert-sym { color: #ff375f; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .alert-sym { color: #ff375f; } }
  .msg { margin-top: 4px !important; }
  .pills { display: grid; gap: 8px; margin-top: 18px; }
  .pill { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 12px; border-radius: 999px; background: var(--fill); color: var(--label); font-weight: 500; transition: background-color var(--t-fade) var(--ease), color var(--t-fade) var(--ease); }
  /* Like Added: the pressed choice crossfades to its done label and turns bleib yellow as a tick draws. */
  .pill.crossfade { display: grid; place-items: center; }
  .done { display: inline-flex; align-items: center; gap: 6px; }
  .tick { display: grid; }
  .tick :global(.draw-tick) { width: 16px; height: 16px; }
  .s2 .pick-at-2 { background: #f6e79a; color: #0a0a0a; }

  /* Notification */
  /* On the marketing site the light theme's page and tray are already yellow, so here a notice is a white card like
     every other; in dark mode it is bleib yellow with black ink, as bleib's notifications are in the product. */
  .note { padding: 14px 16px 16px; }
  :root[data-theme='dark'] .note { --cell: #f6e79a; --label: #0a0a0a; --label-2: rgb(10 10 10 / 0.64); --fill: rgb(255 255 255 / 0.85); --tile: #fffbea; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .note { --cell: #f6e79a; --label: #0a0a0a; --label-2: rgb(10 10 10 / 0.64); --fill: rgb(255 255 255 / 0.85); --tile: #fffbea; }
  }
  .note-head { display: flex; align-items: center; gap: 10px; }
  .note-id { flex: 1; min-width: 0; }
  /* A quiet status capsule, as iOS marks a state. */
  /* A status, not a detail: plain secondary text like Settings' "Automatic", so it never reads as a second pill. */
  .auto { flex: none; color: var(--label-2); }
  /* An AI's icon tile is as tall as the two lines of text beside it (title and detail). */
  .app { width: 42px; height: 42px; border-radius: 10px; padding: 7px; background: var(--tile, var(--fill)); flex: none; }
  .app-tall { width: 50px; height: 50px; border-radius: 12px; padding: 9px; }
  /* bleib's notifications carry bleib's own app icon, its black tile with the yellow mark, in both themes. */
