---
/**
 * A quiet install banner, modelled on Apple's Smart App Banner: a slim bar just under the header that overlays the
 * page (nothing moves) and never takes focus. Desktop Chrome, Edge and Firefox only; never on phones, never once bleib
 * is installed, never on the first screen of a first visit (it waits until the first story scene has scrolled by, or
 * a later visit). Closed with ×, it stays closed (localStorage). Switched by config/install.ts.
 */
import Mark from './Mark.astro';
import { icon } from './icons';
import { INSTALL } from '../config/install';
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const b = t(lang).banner;
const add = t(lang).hero.addTo;
---
{INSTALL.storeButton && INSTALL.banner && (
  <aside class="install-banner" aria-label={b.label} hidden data-title={b.title} data-add={add}>
    <div class="ib-in">
      <span class="ib-mark" aria-hidden="true"><Mark size={20} /></span>
      <p class="ib-text"><span class="ib-title"></span><span class="ib-line">{b.line}</span></p>
      <a class="btn btn-primary ib-add" rel="noopener"></a>
      <button type="button" class="ib-close" aria-label={b.close} set:html={icon('close')} />
    </div>
  </aside>
)}

<script>
  import { INSTALL } from '../config/install';
  import { detect, installed } from '../scripts/install';

  const banner = document.querySelector<HTMLElement>('.install-banner');
  const DISMISSED = 'bleib-install-banner-closed';
  const VISITS = 'bleib-visits';
  const read = (k: string, store: Storage) => { try { return store.getItem(k); } catch { return null; } };
  const write = (k: string, v: string, store: Storage) => { try { store.setItem(k, v); } catch { /* storage blocked */ } };

  async function start(el: HTMLElement) {
    if (!INSTALL.storeButton || !INSTALL.banner || read(DISMISSED, localStorage)) return;
    const store = detect();
    if (!store) return;
    // Count visits, once per browser session.
    let visits = Number(read(VISITS, localStorage) ?? '0');
    if (!read(VISITS, sessionStorage)) { visits += 1; write(VISITS, String(visits), localStorage); write(VISITS, '1', sessionStorage); }
    if (await installed()) return;

    el.querySelector('.ib-title')!.textContent = (el.dataset.title ?? '').replace('{browser}', store.browser);
    const add = el.querySelector<HTMLAnchorElement>('.ib-add')!;
    add.href = store.url;
    add.textContent = (el.dataset.add ?? '').replace('{browser}', store.browser);
    const show = () => { el.hidden = false; requestAnimationFrame(() => el.classList.add('in')); };
    el.querySelector('.ib-close')!.addEventListener('click', () => {
      write(DISMISSED, '1', localStorage);
      el.classList.remove('in');
      setTimeout(() => { el.hidden = true; }, 400);
    });

    if (visits > 1) { setTimeout(show, 1200); return; }
    // First visit: only once the first story scene has scrolled out above the screen.
    const first = document.getElementById('scene-1');
    if (!first) return;
    const seen = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting && e.boundingClientRect.bottom < 0) { seen.disconnect(); show(); }
    });
    seen.observe(first);
  }
  if (banner) void start(banner);
</script>

<style>
  /* Overlays the page just under the header, so nothing below it moves. Desktop only: phones never get it. */
  .install-banner { position: fixed; z-index: 45; top: 76px; left: 0; right: 0; pointer-events: none; }
  .ib-in { pointer-events: auto; width: var(--rails-box); margin: 0 auto; display: flex; align-items: center; gap: 12px; padding: 10px var(--inset); background: var(--page); border-bottom: 1px solid var(--rail); box-shadow: 0 12px 24px -16px rgb(0 0 0 / 0.25);
    opacity: 0; transform: translateY(-14px); transition: opacity var(--t-fade) var(--ease), transform var(--t-open) var(--spring); }
  .in .ib-in { opacity: 1; transform: none; }
  .ib-mark { flex: none; width: 36px; height: 36px; border-radius: 9px; display: grid; place-items: center; background: #0a0a0a; color: #f6e79a; }
  :global(:root[data-theme='dark']) .ib-mark { background: #f6e79a; color: #0a0a0a; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .ib-mark { background: #f6e79a; color: #0a0a0a; } }
  .ib-text { flex: 1; min-width: 0; margin: 0; display: flex; flex-direction: column; }
  .ib-title { font-size: 15px; line-height: 20px; font-weight: 600; color: var(--ink); }
  .ib-line { font-size: 13px; line-height: 18px; color: var(--muted); }
  .ib-add { flex: none; min-height: 36px; padding: 0 16px; font-size: 15px; }
  .ib-close { flex: none; width: 32px; height: 32px; border: 0; border-radius: 50%; display: grid; place-items: center; background: var(--fill); color: var(--muted); cursor: pointer; }
  .ib-close :global(svg) { width: 16px; height: 16px; display: block; }
  @media (max-width: 860px) { .install-banner { display: none; } }
  @media (prefers-reduced-motion: reduce) { .ib-in { transform: none; } }
</style>
