---
/** One story scene: the animated card and its text, side by side (Story.astro lays them out). */
import Lines from './Lines.astro';
import StoryVisual from './StoryVisual.astro';
import { icon, type IconName } from './icons';
import { t, routes, type Lang } from '../i18n/strings';
interface Props { lang: Lang; i: number }
const { lang, i } = Astro.props;
const x = t(lang).story.scenes[i];
/** One symbol per scene, in scene order (adjust, remember, switch, ask, receipt, lock), each with the small effect it plays
 *  as its scene starts, acting out what it means (Symbol in global.css). The sliders, arrows, receipt and lock are drawn
 *  here so their parts can move: the knobs glide, each arrow slides its own way, the receipt unrolls and its lines write
 *  themselves, the shackle snaps shut. */
const SYMBOLS: [IconName | 'sliders' | 'arrows' | 'receipt' | 'padlock', string][] = [['sliders', 'tune'], ['chat_bubble', 'pop'], ['arrows', 'arrows'], ['back_hand', 'wave'], ['receipt', 'receipt'], ['padlock', 'lock']];
const [symbol, effect] = SYMBOLS[i];
---
<article class="scene" id={`scene-${i + 1}`} data-side={i % 2 === 0 ? 'card-left' : 'card-right'}>
  <div class="pair">
    <div class="visual"><StoryVisual lang={lang} scene={i} /></div>
    <div class="text">
      {symbol === 'sliders' ? (
        <span class="sym fx-tune">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
            {[6, 12, 18].map((y) => <rect x="3" y={y - 0.75} width="18" height="1.5" rx="0.75" />)}
            <rect class="knob k1" x="13.5" y="2.5" width="3" height="7" rx="1.5" />
            <rect class="knob k2" x="6.5" y="8.5" width="3" height="7" rx="1.5" />
            <rect class="knob k3" x="10.5" y="14.5" width="3" height="7" rx="1.5" />
          </svg>
        </span>
      ) : symbol === 'arrows' ? (
        <span class="sym fx-arrows">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path class="arrow to-right" d="M4 8h15M15 4l4 4-4 4" />
            <path class="arrow to-left" d="M20 16H5M9 12l-4 4 4 4" />
          </svg>
        </span>
      ) : symbol === 'receipt' ? (
        <span class="sym fx-receipt">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path class="paper" d="M6 3h12a1 1 0 0 1 1 1v17l-2.3-1.5-2.4 1.5-2.3-1.5-2.3 1.5-2.4-1.5L5 21V4a1 1 0 0 1 1-1z" />
            <path class="line l1" d="M9 8.5h6" pathLength="1" />
            <path class="line l2" d="M9 12.5h6" pathLength="1" />
          </svg>
        </span>
      ) : symbol === 'padlock' ? (
        <span class="sym fx-lock">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
            <path class="shackle" d="M8 12V9a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
            <rect class="lock-body" x="5" y="11.5" width="14" height="10" rx="2.5" />
          </svg>
        </span>
      ) : (
        <span class={`sym fx-${effect}`} set:html={icon(symbol)} />
      )}
      <h2 class="h2"><span>{x.h[0]}</span><br /><span>{x.h[1]}</span></h2>
      <p class="lead"><Lines text={x.p} /></p>
      <a class="more" href={`${routes[x.more.to as keyof typeof routes][lang]}${x.more.hash}`}>{x.more.label}<span set:html={icon('chevron_right')} /></a>
    </div>
  </div>
</article>

<style>
  /* Calm, like a printed spread: each scene stays put; only the card inside it changes. */
  .scene { position: relative; z-index: 1; min-height: min(88vh, 860px); display: flex; align-items: center; padding: clamp(40px, 6vw, 72px) 0; }
  .pair {
    width: min(calc(min(420px, 34vw) + clamp(48px, 6vw, 104px) + min(500px, 44vw)), var(--colw));
    margin: 0 auto;
    display: grid;
    grid-template-columns: min(500px, 44vw) min(420px, 34vw);
    justify-content: space-between;
    align-items: center;
  }
  .scene[data-side='card-right'] .pair { grid-template-columns: min(420px, 34vw) min(500px, 44vw); }
  .scene[data-side='card-right'] .visual { order: 2; }
  /* --scene-ink and --scene-muted let a section recolour its scenes (the black privacy section). */
  .text { color: var(--scene-ink, inherit); }
  /* Like Apple's feature blocks: a symbol above the headline, in the headline's colour, no tile. */
  .sym { display: block; width: 20px; height: 20px; margin-bottom: 12px; }
  /* Each headline line wraps evenly on its own, so no word is left alone. */
  .h2 span { display: inline-block; text-wrap: balance; }
  .sym :global(svg) { width: 100%; height: 100%; display: block; }
  /* As the scene starts, its symbol plays first, in the pause before the card moves. */
  .scene:has([data-playing]) .sym :global(svg) { animation: var(--fx) 0.8s var(--fx-ease, var(--ease)) 0.15s both; }
  /* Waiting to play: the bubble and the receipt are still to come; the lock stands open. */
  .fx-pop :global(svg) { transform: scale(0); transform-origin: 15% 90%; }
  .paper { transform-box: fill-box; transform-origin: 50% 0; transform: scaleY(0.15); }
  .line { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .scene:has([data-playing]) .paper { animation: fx-unroll 0.5s var(--ease) 0.15s both; }
  .scene:has([data-playing]) .line { animation: fx-write 0.35s var(--ease) var(--at) both; }
  .l1 { --at: 0.6s; } .l2 { --at: 0.8s; }
  /* The lock stands open, then the shackle drops shut and the body clicks. */
  .shackle { transform: translateY(-3.5px); }
  .lock-body { transform-box: fill-box; transform-origin: 50% 100%; }
  .scene:has([data-playing]) .shackle { animation: fx-shackle 0.4s cubic-bezier(0.55, 0, 0.75, 0) 0.35s both; }
  .scene:has([data-playing]) .lock-body { animation: fx-click 0.3s var(--ease) 0.75s both; }
  .to-right { --way: 1; } .to-left { --way: -1; }
  .scene:has([data-playing]) .arrow { animation: fx-arrow 0.8s var(--ease) 0.15s both; }
  /* The sliders' knobs glide to new places, one after another, and stay there. */
  .k1 { --to: -7px; } .k2 { --to: 8px; --delay: 0.1s; } .k3 { --to: 5px; --delay: 0.2s; }
  .scene:has([data-playing]) .knob { animation: fx-knob 0.8s var(--ease) calc(0.15s + var(--delay, 0s)) both; }
  .text .lead { margin: 18px 0 0; color: var(--scene-muted, var(--muted)); text-wrap: balance; }
  /* Apple-style "Learn more ›" */
  .more { display: inline-flex; align-items: center; gap: 1px; margin-top: 14px; font-size: 17px; font-weight: 500; text-decoration: none; color: var(--scene-ink, var(--ink)); }
  .more :global(svg) { width: 20px; height: 20px; display: block; transition: transform 0.2s var(--ease); }
  .more:hover { text-decoration: underline; text-underline-offset: 4px; }
  .more:hover :global(svg) { transform: translateX(2px); }
  :global(:root[data-theme='dark']) .more { color: var(--scene-ink, #f6e79a); }

  @media (max-width: 767px) {
    .scene { min-height: 0; padding: 72px 0 40px; }
    .pair, .scene[data-side='card-right'] .pair { width: var(--colw); grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .visual, .text { min-width: 0; }
    .scene .text { order: -1; }
    .scene[data-side='card-right'] .visual { order: 0; }
  }
</style>
