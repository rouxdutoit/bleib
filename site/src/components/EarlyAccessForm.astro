---
import DrawTick from './DrawTick.astro';
import { icon } from './icons';
import { routes, t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const f = t(lang).form;
---
<form
  class="ea"
  method="post"
  action="/api/early-access"
  novalidate
  data-early-access
  data-msg-success={f.success}
  data-msg-invalid={f.invalid}
  data-msg-rate={f.rate}
  data-msg-error={f.error}
  data-msg-sending={f.sending}
>
  <input type="hidden" name="lang" value={lang} />
  <div class="hp" aria-hidden="true">
    <label>{f.honeypot}<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
  </div>
  <label class="sr-only" for={`ea-email-${lang}`}>{f.label}</label>
  <div class="ea-row">
    <input
      id={`ea-email-${lang}`}
      class="ea-input"
      type="email"
      name="email"
      inputmode="email"
      autocomplete="email"
      required
      maxlength="254"
      placeholder={f.label}
      aria-describedby={`ea-status-${lang} ea-note-${lang}`}
    />
    <button class="btn btn-primary ea-btn" type="submit"><span class="ea-label">{f.submit}</span><span class="ea-send" aria-hidden="true" set:html={icon('send')} /></button>
  </div>
  <p class="ea-status" id={`ea-status-${lang}`} role="status" aria-live="polite"><span class="ea-tick" aria-hidden="true"><DrawTick /></span><span class="ea-msg"></span></p>
  <p class="ea-note" id={`ea-note-${lang}`}>
    {f.note} <a href={routes.privacy[lang]}>{f.privacy}</a>
  </p>
</form>
<style>
  .ea { width: 100%; max-width: 480px; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .ea-row { display: flex; gap: 8px; justify-content: center; }
  .ea-input {
    flex: 1 1 auto; min-width: 0; min-height: 48px; padding: 10px 18px; border-radius: 999px;
    border: 0; background: var(--card); color: var(--on-card);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ea-input::placeholder { color: var(--on-card-muted); }
  .ea-input[aria-invalid='true'] { box-shadow: inset 0 0 0 2px #b42318; }
  /* Like Messages: while you type, the field takes the room and the button becomes a round send arrow. */
  .ea-btn { position: relative; flex: none; min-height: 48px; max-width: 16em; overflow: hidden; white-space: nowrap; transition: max-width var(--t-open) var(--ease), padding var(--t-open) var(--ease); }
  .ea-label { transition: opacity var(--t-fade) var(--ease); }
  .ea-send { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; transition: opacity var(--t-fade) var(--ease); }
  .ea-send :global(svg) { width: 20px; height: 20px; margin-left: 2px; }
  .ea-row:focus-within .ea-btn { max-width: 48px; padding-inline: 0; }
  .ea-row:focus-within .ea-label { opacity: 0; }
  .ea-row:focus-within .ea-send { opacity: 1; }
  .ea-status { min-height: 1.5em; margin: 10px 0 0; font-size: 15px; font-weight: 500; text-align: center; }
  /* On success a bleib-yellow check draws itself beside the thank-you, like the checks in the cards. */
  .ea-tick { display: none; width: 20px; height: 20px; margin-right: 6px; border-radius: 50%; place-items: center; vertical-align: -4px; background: #f6e79a; color: #0a0a0a; }
  .ok .ea-tick { display: inline-grid; }
  .ok .ea-tick :global(.draw) { animation: draw var(--t-fade) var(--ease) var(--t-lag) both; }
  .ea-note { margin: 4px 0 0; font-size: 13px; color: var(--muted); text-align: center; }
  .ea-note a { color: inherit; }
  .ea.is-done .ea-row { display: none; }
</style>
<script>
  import { initEarlyAccess } from '../scripts/earlyAccess';
  initEarlyAccess();
</script>
