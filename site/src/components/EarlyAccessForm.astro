---
import DrawTick from './DrawTick.astro';
import { routes, t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const f = t(lang).form;
---
{/* The browser's own checks (required, type="email") work without JavaScript; the script turns them off with
    novalidate only once its own handler, with its own messages, is bound. */}
<form
  class="ea"
  method="post"
  action="/api/early-access"
  data-early-access
  data-msg-success={f.success}
  data-msg-invalid={f.invalid}
  data-msg-rate={f.rate}
  data-msg-error={f.error}
  data-msg-sending={f.sending}
>
  <input type="hidden" name="lang" value={lang} />
  <div class="hp" aria-hidden="true">
    <label>{f.honeypot}<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
  </div>
  <label class="ea-label-field" for={`ea-email-${lang}`}>{f.label}</label>
  <div class="ea-row">
    <input
      id={`ea-email-${lang}`}
      class="ea-input"
      type="email"
      name="email"
      inputmode="email"
      autocomplete="email"
      autocapitalize="off"
      spellcheck="false"
      required
      maxlength="254"
      placeholder={f.placeholder}
      aria-describedby={`ea-status-${lang} ea-note-${lang}`}
    />
    <button class="btn btn-primary ea-btn" type="submit"><span class="ea-label">{f.submit}</span></button>
  </div>
  <p class="ea-status" id={`ea-status-${lang}`} role="status" aria-live="polite"><span class="ea-tick" aria-hidden="true"><DrawTick /></span><span class="ea-msg"></span></p>
  <p class="ea-note" id={`ea-note-${lang}`}>
    {f.note} <a href={routes.privacy[lang]}>{f.privacy}</a>
  </p>
</form>
<style>
  .ea { --field-line: #76767a; width: 100%; max-width: 480px; text-align: left; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  /* The label stays in view above the field, aligned with the text inside it (Footnote, semibold). */
  .ea-label-field { display: block; margin: 0 0 8px; padding-inline-start: 19px; font-size: 13px; line-height: 18px; font-weight: 600; color: var(--ink); }
  .ea-row { display: flex; gap: 8px; }
  /* A persistent 1px edge (#76767a) holds at least 3:1 against both the page and the field, in light and dark mode
     (3.6:1 on yellow, 4.5:1 on white; 4.4:1 on black, 3.9:1 on the dark field); focus adds its own ring outside it. */
  .ea-input {
    flex: 1 1 auto; min-width: 0; min-height: 48px; padding: 10px 18px; border-radius: 999px;
    border: 1px solid var(--field-line); background: var(--card); color: var(--on-card);
  }
  .ea-input::placeholder { color: var(--on-card-muted); opacity: 1; }
  .ea-input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 999px; }
  .ea-input[aria-invalid='true'] { border-color: #b42318; box-shadow: inset 0 0 0 1px #b42318; }
  .ea-btn { flex: none; justify-content: center; min-height: 48px; white-space: nowrap; }
  .ea-btn:focus-visible { border-radius: 999px; }
  /* Where the field and the button don't both fit on one line, the button goes full width underneath. */
  @media (max-width: 400px) {
    .ea-row { flex-direction: column; }
  }
  .ea-status { min-height: 1.5em; margin: 10px 0 0; font-size: 15px; font-weight: 500; text-align: center; }
  /* On success a bleib-yellow check draws itself beside the thank-you, like the checks in the cards. */
  .ea-tick { display: none; width: 20px; height: 20px; margin-right: 6px; border-radius: 50%; place-items: center; vertical-align: -4px; background: #f6e79a; color: #0a0a0a; }
  .ok .ea-tick { display: inline-grid; }
  .ok .ea-tick :global(.draw) { animation: draw var(--t-fade) var(--ease) var(--t-lag) both; }
  .ea-note { margin: 4px 0 0; font-size: 13px; color: var(--muted); text-align: center; }
  .ea-note a { color: inherit; }
  .ea.is-done .ea-row, .ea.is-done .ea-label-field { display: none; }
</style>
<script>
  import { initEarlyAccess } from '../scripts/earlyAccess';
  initEarlyAccess();
  // The handler is bound now, with its own messages, so the browser's own bubbles step aside.
  document.querySelectorAll<HTMLFormElement>('form[data-early-access][data-bound]').forEach((form) => (form.noValidate = true));
</script>
