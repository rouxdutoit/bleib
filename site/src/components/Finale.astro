---
import Mark from './Mark.astro';
import Rails from './Rails.astro';
import EarlyAccessForm from './EarlyAccessForm.astro';
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).finale;
const tilt = [-4, 3, -2, 2, -3, 4, -2, 4, -4, 3, -3, 2];
---
<section class="finale has-rails" id="early-access" aria-labelledby="finale-title">
  <Rails />
  <div class="wrap grid">
    <div class="copy">
      <h2 id="finale-title" class="h1">{s.h}</h2>
      <p class="lead">{s.p}</p>
      <EarlyAccessForm lang={lang} />
    </div>
    <div class="play" data-play data-count-tpl={s.count} data-total={s.items.length}>
      <p class="prompt t-foot c-2" data-prompt-text={s.playPrompt} data-done-text={s.done}>{s.playPrompt}</p>
      <div class="area" data-area>
        <div class="chips">
        {s.items.map((item, i) => (
          <button
            type="button"
            class="chip"
            data-chip
            aria-label={s.putIn.replace('{item}', item)}
          >
            <span class:list={['chip-dot', { lockdot: item === s.lockedItem }]} aria-hidden="true"></span>
            <span>{item}</span>
          </button>
        ))}
        </div>
        <div class="wallet" data-wallet>
          <span class="wallet-tile" aria-hidden="true"><Mark size={26} /></span>
          <span class="wallet-label">{s.walletLabel}</span>
          <span class="wallet-count" data-count aria-live="polite">{s.count.replace('{n}', '0').replace('{total}', String(s.items.length))}</span>
        </div>
      </div>
      <div class="play-actions">
        <button class="btn btn-secondary" type="button" data-all-in>{s.allIn}</button>
        <button class="btn btn-secondary" type="button" data-reset hidden>{s.reset}</button>
      </div>
    </div>
  </div>
</section>

<style>
  .finale { padding: clamp(72px, 10vw, 140px) 0; }
  .grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .copy .lead { margin: 18px 0 28px; }
  .prompt { margin: 0 0 10px; text-align: center; }
  /* Tray (radius 34, padding 16) wraps a grid of straight chips and the wallet; nothing can leave it. */
  .area {
    position: relative; overflow: hidden; touch-action: none;
    padding: 16px; border-radius: 34px; background: var(--tray);
    display: grid; gap: 16px;
  }
  .chips { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 168px), 1fr)); gap: 8px; }
  .chip {
    position: relative; z-index: 1;
    transform: translate(var(--dx, 0px), var(--dy, 0px));
    display: flex; align-items: center; gap: 10px; min-height: 44px; width: 100%;
    padding: 0 14px; border: 0; border-radius: 18px; cursor: grab; text-align: left;
    background: var(--cell); color: var(--label); border: var(--card-border);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
    font-size: 15px; line-height: 20px; letter-spacing: -0.015em;
    user-select: none; -webkit-user-select: none;
    transition: transform 0.45s var(--ease), opacity 0.35s var(--ease);
  }
  .chip.dragging { cursor: grabbing; transition: none; z-index: 5; box-shadow: 0 12px 28px -8px rgb(0 0 0 / 0.3); }
  .chip.in { opacity: 0; pointer-events: none; transform: translate(var(--tx, 0px), var(--ty, 0px)) scale(0.4); }
  .chip-dot { width: 8px; height: 8px; border-radius: 50%; background: #c9a400; flex: none; }
  .chip-dot.lockdot { background: var(--label); }
  .wallet {
    display: grid; grid-template-columns: auto 1fr; column-gap: 12px; align-items: center;
    padding: 12px 16px; border-radius: 18px; min-height: 64px;
    background: #0a0a0a; color: #ffffff;
    transition: transform 0.25s var(--ease);
  }
  .wallet.hot { transform: scale(1.02); }
  .wallet-tile { grid-row: 1 / 3; width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: #1c1c1e; color: #f6e79a; }
  .wallet-label { font-size: 17px; line-height: 22px; font-weight: 600; letter-spacing: -0.025em; }
  .wallet-count { font-size: 13px; line-height: 18px; color: rgb(235 235 245 / 0.6); }
  .play-actions { display: flex; justify-content: center; gap: 8px; margin-top: 12px; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { initFinale } from '../scripts/finale';
  initFinale();
</script>
