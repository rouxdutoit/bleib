---
import Lines from './Lines.astro';
/**
 * The closer: like the end of an Apple product page, the bleib mark, the promise behind the name
 * ("bleib" is German for "stay") and one action. The mark blinks once as it comes into view, then stays still.
 */
import { MARK_BODY, MARK_EYES, MARK_VIEWBOX } from './markPath';
import Rails from './Rails.astro';
import EarlyAccessForm from './EarlyAccessForm.astro';
import LaunchCta from './LaunchCta.astro';
import { INSTALL } from '../config/install';
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).finale;
---
<section class="finale has-rails" id="early-access" aria-labelledby="finale-title">
  <Rails />
  <div class="wrap inner">
    <span class="logo" data-fx aria-hidden="true">
      <svg viewBox={MARK_VIEWBOX} width="56" height="63" fill="none" focusable="false">
        <path fill="currentColor" fill-rule="evenodd" d={MARK_BODY} />
        {MARK_EYES.map((d) => <path class="eye" d={d} />)}
      </svg>
    </span>
    <h2 id="finale-title" class="title">{s.h}</h2>
    <p class="sub"><Lines text={s.p} /></p>
    <div class="form" data-prelaunch hidden={INSTALL.launched}><EarlyAccessForm lang={lang} /></div>
    <div class="form"><LaunchCta lang={lang} /></div>
  </div>
</section>

<style>
  .finale { padding: clamp(96px, 12vw, 160px) 0 clamp(72px, 9vw, 120px); }
  .inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; }

  /* The bleib mark on its own, black on gold and gold in dark mode (like the header). */
  .logo { display: block; width: clamp(48px, 5vw, 56px); margin: 0 0 clamp(24px, 3vw, 32px); color: #0a0a0a; }
  :global(:root[data-theme='dark']) .logo { color: #f6e79a; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo { color: #f6e79a; }
  }
  .logo :global(svg) { width: 100%; height: auto; display: block; }
  /* The eyes are the page colour over the body, so they read as the mark's holes; one blink squeezes them shut for a
     moment as the mark comes into view (scripts/story.ts adds .on), and then they stay open. Reduced motion: no blink. */
  .eye { fill: var(--page); transform-box: fill-box; transform-origin: center; }
  .logo:global(.on) .eye { animation: blink 0.3s var(--ease) 0.4s 1; }
  @keyframes blink { 0%, 100% { transform: none; } 50% { transform: scaleY(0.1); } }
  @media (prefers-reduced-motion: reduce) { .logo:global(.on) .eye { animation: none; } }

  /* Same size and weight as the hero headline, so the page opens and closes in one voice. */
  .title { margin: 0; max-width: 22ch; font-size: clamp(38px, 5.4vw, 64px); line-height: 1.07; letter-spacing: -0.03em; font-weight: 600; text-wrap: balance; }
  .sub { margin: 18px 0 0; font-size: clamp(17px, 1.7vw, 21px); line-height: 1.45; color: var(--muted); text-wrap: balance; }
  .form { margin-top: 32px; width: 100%; display: flex; justify-content: center; }
  .form[hidden], .form:has(> [hidden]) { display: none; }
</style>
