---
import Lines from './Lines.astro';
/** The closer: the password-manager moment the hero promises, and one action. */
import Window from './Window.astro';
import BleibCard from './BleibCard.astro';
import Composer from './Composer.astro';
import Rails from './Rails.astro';
import EarlyAccessForm from './EarlyAccessForm.astro';
import { t, type Lang } from '../i18n/strings';
import reserveScenes from '../scripts/reserve.js?raw';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).finale;
---
<section class="finale has-rails" id="early-access" aria-labelledby="finale-title">
  <Rails />
  <div class="wrap inner">
    <figure class="scene" aria-hidden="true">
      <Window tabs={[{ ai: s.prompt.tab, icon: 'claude-color' }]}>
        <div class="body" data-sv data-steps="4" data-interval="900" data-gaps=",900,2200" data-step="0">
          <p class="t-body bubble appear at-2">{s.prompt.said}</p>
          <BleibCard title={s.prompt.title} facts={[{ t: s.prompt.fact, icon: 'flight' }]} action={s.prompt.save} done={s.prompt.saved} at={3} />
          <Composer typed={s.prompt.said} sentAt={2} />
        </div>
      </Window>
    </figure>
    <h2 id="finale-title" class="title">{s.h}</h2>
    <p class="sub"><Lines text={s.p} /></p>
    <div class="form"><EarlyAccessForm lang={lang} /></div>
  </div>
</section>
{/* The closer is the last scene: from here every scene reserves its height before the page appears. */}
<script is:inline set:html={reserveScenes} />

<style>
  .finale { padding: clamp(96px, 12vw, 160px) 0 clamp(72px, 9vw, 120px); }
  .inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; }

  /* A picture, not a control: a chat with bleib's card, styled exactly like the hero's. */
  .scene { margin: 0 0 clamp(40px, 6vw, 64px); width: min(440px, 100%); }
  /* Like the hero: you type, you send, bleib offers to save it, Save is pressed (scripts/story.ts). */
  .body { --bleib-card-margin: 0 0 8px; display: flex; flex-direction: column; justify-content: flex-end; padding: 16px; }
  .bubble { align-self: flex-end; max-width: 80%; margin: 0 0 12px; padding: 8px 14px; border-radius: 18px; background: var(--fill); }

  .title { font-size: clamp(44px, 7vw, 88px); line-height: 1.02; letter-spacing: -0.035em; font-weight: 700; }
  .sub { margin: 18px 0 0; font-size: clamp(17px, 1.7vw, 21px); line-height: 1.45; color: var(--muted); text-wrap: balance; }
  .form { margin-top: 32px; width: 100%; display: flex; justify-content: center; }
</style>
