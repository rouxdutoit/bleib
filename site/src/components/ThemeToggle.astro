---
import { t, type Lang } from '../i18n/strings';
import { icon } from './icons';
interface Props { lang: Lang }
const s = t(Astro.props.lang).nav;
---
<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-label-dark={s.themeToDark}
  data-label-light={s.themeToLight}
  aria-label={s.themeToDark}
>
  <span class="i-moon" set:html={icon('dark_mode')} />
  <span class="i-sun" set:html={icon('light_mode')} />
</button>
<style>
  .theme-toggle {
    width: 44px; height: 44px; margin: -6px; border: 0; border-radius: 999px; padding: 0; cursor: pointer;
    display: grid; place-items: center; background: none; color: var(--muted);
  }
  .theme-toggle:hover { color: var(--ink); }
  .theme-toggle :global(svg) { width: 16px; height: 16px; display: block; }
  .i-sun { display: none; }
  :global(:root[data-theme='dark']) .i-sun { display: block; }
  :global(:root[data-theme='dark']) .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun { display: block; }
    :global(:root:not([data-theme='light'])) .i-moon { display: none; }
  }
</style>
