---
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const s = t(Astro.props.lang).nav;
---
<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-label-dark={s.themeToDark}
  data-label-light={s.themeToLight}
  aria-label={s.themeToDark}
>
  <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor"/></svg>
  <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
</button>
<style>
  .theme-toggle {
    width: 44px; height: 44px; border-radius: 999px; border: 0; cursor: pointer;
    display: grid; place-items: center; background: var(--btn2); color: var(--btn2-ink);
    box-shadow: inset 0 0 0 1px var(--line);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
  }
  .theme-toggle svg { width: 18px; height: 18px; }
  .i-sun { display: none; }
  :global(:root[data-theme='dark']) .i-sun { display: block; }
  :global(:root[data-theme='dark']) .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun { display: block; }
    :global(:root:not([data-theme='light'])) .i-moon { display: none; }
  }
</style>
