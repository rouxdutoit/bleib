---
import Logo from './Logo.astro';
import { GITHUB_URL, routes, t, otherLang, type Lang, type RouteKey } from '../i18n/strings';
interface Props { lang: Lang; page: RouteKey }
const { lang, page } = Astro.props;
const s = t(lang).nav;
const githubHref = GITHUB_URL || routes.developers[lang];
// The same page in the other language, as in the footer.
const other = otherLang(lang);
const earlyHref = Astro.url.pathname === routes.home[lang] ? '#early-access' : `${routes.home[lang]}#early-access`; // only the homepage has the form (the 404 renders as page "home")
const links: { key: RouteKey; label: string }[] = [
  { key: 'how', label: s.how },
  { key: 'security', label: s.security },
  { key: 'developers', label: s.developers },
  { key: 'pricing', label: s.pricing },
];
---
<header class="site-header" data-header>
  <div class="frame">
    <Logo lang={lang} />
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      <span class="sr-only">{s.menu}</span>
    </button>
    <nav class="nav" id="site-nav" aria-label={s.label}>
      <div class="nav-in">
        <ul class="links">
          {links.map((l) => (
            <li><a href={routes[l.key][lang]} aria-current={l.key === page ? 'page' : undefined}>{l.label}</a></li>
          ))}
          <li><a href={githubHref}>{s.github}</a></li>
          <li><a class="lang" href={routes[page][other]} hreflang={other} lang={other} aria-label={s.langSwitchLabel}>{s.langSwitch}</a></li>
        </ul>
        <a class="btn btn-primary cta" href={earlyHref} data-install data-add={t(lang).hero.addTo} data-installed={t(lang).hero.installed} data-open={t(lang).launch.open}>{s.early}</a>
      </div>
    </nav>
  </div>
</header>
{/* Shows the menu button before the page first appears. Without JavaScript there is no button and the phone menu stays
    closed, so it never covers the page; every link is also in the footer. */}
<script is:inline>
  (function () {
    var header = document.querySelector('[data-header]');
    header.classList.add('js');
    header.querySelector('.menu-btn').hidden = false;
  })();
</script>
<script>
  // The main button names your browser's store once the store listings exist (config/install.ts).
  // Loaded only when that switch is on, so the header ships without it until then.
  import { INSTALL } from '../config/install';
  if (INSTALL.storeButton) void import('../scripts/install').then((m) => m.initInstall());
  // Launch day (or a ?launch=1 preview): the hero's and the finale's actions change (scripts/launch.ts).
  if (INSTALL.launched || /[?&]launch=1\b/.test(location.search)) void import('../scripts/launch').then((m) => m.initLaunch());
  // Mobile menu, as on fazit.dev: closes on a link, Escape, focus leaving the header, or a wider screen.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = header?.querySelector<HTMLButtonElement>('.menu-btn');
  if (header && button) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      header.toggleAttribute('data-open', open);
    };
    button.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
    header.querySelector('nav')?.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    header.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (next && !header.contains(next)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        button.focus();
      }
    });
    matchMedia('(min-width: 961px)').addEventListener('change', () => setOpen(false));

    // On phones, like Safari's bars: the header slides away as you scroll down and returns as you scroll up.
    // It stays while the menu is open, near the top, and whenever something in it has keyboard focus.
    let last = scrollY;
    addEventListener('scroll', () => {
      const y = scrollY, delta = y - last;
      if (Math.abs(delta) < 6) return;
      header.toggleAttribute('data-hidden', delta > 0 && y > 76 && !header.hasAttribute('data-open') && !header.querySelector(':focus-visible'));
      last = y;
    }, { passive: true });
    header.addEventListener('focusin', () => { if (header.querySelector(':focus-visible')) header.removeAttribute('data-hidden'); });
  }
</script>
<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: var(--page);
  }
  /* The header sits inside the page rails; its bottom edge is a guide line with joiners. */
  .frame {
    position: relative;
    width: var(--rails-box);
    height: 76px;
    margin: 0 auto;
    padding: 0 var(--inset);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-left: 1px solid var(--rail);
    border-right: 1px solid var(--rail);
    border-bottom: 1px solid var(--rail);
  }
  .frame::before,
  .frame::after,
  .nav::before,
  .nav::after {
    content: '';
    position: absolute;
    bottom: -5px;
    width: 9px;
    height: 9px;
    background:
      linear-gradient(var(--joint), var(--joint)) center / 9px 1px no-repeat,
      linear-gradient(var(--joint), var(--joint)) center / 1px 9px no-repeat;
  }
  .frame::before { left: -5px; background-size: 5px 1px, 1px 9px; background-position: right center, center center; }
  .frame::after { right: -5px; background-size: 5px 1px, 1px 9px; background-position: left center, center center; }
  .nav::before, .nav::after { display: none; }

  .nav-in { display: flex; align-items: center; gap: clamp(12px, 2.2vw, 30px); }
  .links { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: clamp(12px, 2.2vw, 30px); }
  .links a { font-size: 15px; text-decoration: none; color: var(--muted); padding: 10px 0; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }
  .links a:hover, .links a[aria-current='page'] { color: var(--ink); }
  /* The current page is underlined too, so it never depends on colour alone. */
  .links a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; }
  .cta { gap: 10px; white-space: nowrap; }
  .cta :global(svg) { width: 16px; height: 16px; }

  .menu-btn { display: none; }

  @media (max-width: 960px) {
    .site-header { transition: transform 0.3s var(--ease); }
    .site-header[data-hidden] { transform: translateY(-100%); }
    .frame { height: 64px; padding: 0 12px 0 var(--inset); }
    .menu-btn:not([hidden]) {
      display: inline-grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 12px;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }
    .menu-btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
    .menu-icon { position: relative; width: 18px; height: 12px; }
    .menu-icon > span {
      position: absolute;
      left: 0;
      right: 0;
      top: 1.5px;
      height: 1.5px;
      border-radius: 999px;
      background: currentColor;
      transition: transform var(--t-fade) var(--ease);
    }
    .menu-icon > span + span { top: auto; bottom: 1.5px; }
    [aria-expanded='true'] > .menu-icon > span { transform: translateY(3.75px) rotate(45deg); }
    [aria-expanded='true'] > .menu-icon > span + span { transform: translateY(-3.75px) rotate(-45deg); }

    /* The menu drops down between the two rails, not across the full screen. */
    .nav {
      position: absolute;
      top: calc(100% + 1px);
      left: 0;
      right: 0;
      display: grid;
      grid-template-rows: 1fr;
      background: var(--page);
    }
    .nav-in {
      min-height: 0;
      overflow: hidden;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0 var(--inset);
    }
    .links { flex-direction: column; align-items: stretch; gap: 0; padding-top: 8px; }
    .links li + li { border-top: 1px solid var(--hairline); }
    .links a { display: flex; min-height: 48px; padding: 0; font-size: 17px; color: var(--ink); }
    .links a[aria-current='page'] { font-weight: 600; text-underline-offset: 5px; }
    .cta { align-self: flex-start; margin: 20px 0 24px; }

    .site-header:not(.js) .nav { display: none; }
    .js .nav {
      grid-template-rows: 0fr;
      opacity: 0;
      visibility: hidden;
      /* Opens like a Reveal from the motion kit (global.css). */
      transition: grid-template-rows var(--t-open) var(--ease), opacity var(--t-fade) var(--ease), visibility 0s linear var(--t-open);
    }
    .js[data-open] .nav {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
      border-bottom: 1px solid var(--rail);
      box-shadow: 0 24px 32px -16px rgb(0 0 0 / 0.18);
    }
    /* On a short screen (a phone on its side) the open menu scrolls within itself, down to its last item, without
       moving the page underneath: it stops at the bottom of the screen (64px header, 1px line above and below). */
    .js[data-open] .nav-in {
      max-height: calc(100dvh - 66px - env(safe-area-inset-bottom, 0px));
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }
    .js[data-open] .nav::before,
    .js[data-open] .nav::after { display: block; }
    .nav::before { left: -5px; background-size: 5px 1px, 1px 9px; background-position: right center, center center; }
    .nav::after { right: -5px; background-size: 5px 1px, 1px 9px; background-position: left center, center center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
</style>
