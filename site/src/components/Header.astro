---
import Logo from './Logo.astro';
import { GITHUB_URL, routes, t, type Lang, type RouteKey } from '../i18n/strings';
interface Props { lang: Lang; page: RouteKey }
const { lang, page } = Astro.props;
const s = t(lang).nav;
const githubHref = GITHUB_URL || routes.developers[lang];
const earlyHref = page === 'home' ? '#early-access' : `${routes.home[lang]}#early-access`;
---
<header class="site-header">
  <div class="bar">
    <Logo lang={lang} />
    <nav class="actions" aria-label="Primary">
      <a class="btn btn-secondary hide-sm" href={githubHref}>{s.github}</a>
      <a class="btn btn-primary" href={earlyHref}>{s.early}</a>
    </nav>
  </div>
</header>
<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    padding: 12px 0;
    background: color-mix(in srgb, var(--page) 84%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--rail);
  }
  .bar { width: var(--rail-w); margin: 0 auto; padding: 0 clamp(0px, 1.5vw, 16px); display: flex; align-items: center; justify-content: space-between; gap: 12px; max-width: none; }
  .actions { display: flex; align-items: center; gap: 8px; }
  @media (max-width: 640px) {
    .hide-sm { display: none; }
    .site-header :global(.btn) { padding: 10px 14px; font-size: 14px; }
  }
</style>
