---
import { MARK_PATH, MARK_VIEWBOX } from './markPath';
interface Props { size?: number }
const { size = 24 } = Astro.props;
---
<svg
  width={size}
  height={Math.round(size * 1.125)}
  viewBox={MARK_VIEWBOX}
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path fill="currentColor" fill-rule="evenodd" d={MARK_PATH} />
</svg>
