---
/** The story: one scene per idea, then the privacy scene in its own black section. */
import StoryScene from './StoryScene.astro';
import Rails from './Rails.astro';
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).story;
const all = s.scenes.map((x, i) => ({ i, dark: 'dark' in x }));
---
<section class="story has-rails" aria-label={s.label}>
  <Rails />
  {all.filter((x) => !x.dark).map((x) => <StoryScene lang={lang} i={x.i} />)}
</section>
{all.filter((x) => x.dark).map((x) => (
  <section class="story story-dark has-rails"><Rails /><StoryScene lang={lang} i={x.i} /></section>
))}

<style>
  .story { position: relative; padding: clamp(24px, 4vw, 64px) 0; }
  /* The privacy scene has its own section: the whole box between the rails turns black with bleib yellow
     in both themes. Rails and joints on it turn yellow; the half of each joint outside stays. */
  .story-dark { --v-bg: #0a0a0a; --v-ink: #f6e79a; --v-muted: rgb(245 241 230 / 0.62); --focus: #f6e79a; --scene-ink: var(--v-ink); --scene-muted: var(--v-muted); }
  .story-dark::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: var(--rails-box); transform: translateX(-50%); background: var(--v-bg); }
  .story-dark :global(.rails) { border-color: color-mix(in srgb, var(--v-ink) 32%, transparent); }
  .story-dark :global(.rails::before), .story-dark :global(.rails::after) {
    background:
      linear-gradient(var(--v-ink), var(--v-ink)) right center / 5px 1px no-repeat,
      linear-gradient(to bottom, var(--joint) 5px, var(--v-ink) 5px) center / 1px 9px no-repeat;
  }
  .story-dark :global(.rails::after) { background-position: left center, center center; }
  /* The following section's joints reach up into the black, so their upper half turns yellow too. */
  .story-dark ~ :global(section) { --v-ink: #f6e79a; }
  .story-dark ~ :global(section .rails::before), .story-dark ~ :global(section .rails::after) {
    background:
      linear-gradient(var(--joint), var(--joint)) right center / 5px 1px no-repeat,
      linear-gradient(to bottom, var(--v-ink) 5px, var(--joint) 5px) center / 1px 9px no-repeat;
  }
  .story-dark ~ :global(section .rails::after) { background-position: left center, center center; }
</style>

<script>
  import { initStory } from '../scripts/story';
  initStory();
</script>
