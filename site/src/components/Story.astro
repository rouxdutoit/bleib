---
import StoryVisual from './StoryVisual.astro';
import Rails from './Rails.astro';
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).story;
const pauseIcon = '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/><rect x="9.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/></svg>';
const playIcon = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.8v10.4a.8.8 0 0 0 1.2.7l8.4-5.2a.8.8 0 0 0 0-1.4L5.7 2.1a.8.8 0 0 0-1.2.7Z" fill="currentColor"/></svg>';
---
<section class="story has-rails" data-story aria-label={s.label}>
  <Rails />
  <div class="stage" aria-hidden="true" data-stage>
    <div class="stage-card" data-side="right">
      {s.scenes.map((_, i) => (
        <div class:list={['slot', { active: i === 0 }]} data-slot={i}>
          <StoryVisual lang={lang} scene={i} />
        </div>
      ))}
    </div>
  </div>

  <div class="frames">
    {s.scenes.map((scene, i) => (
      <article class="frame" data-frame={i} id={`scene-${i + 1}`} data-side={i % 2 === 0 ? 'left' : 'right'}>
        <div class="frame-text">
          <h2 class="h2"><span>{scene.h[0]}</span><br /><span>{scene.h[1]}</span></h2>
          <p class="lead">{scene.p}</p>
        </div>
        <div class="frame-visual is-final">
          <StoryVisual lang={lang} scene={i} />
        </div>
      </article>
    ))}
  </div>


  <button
    class="pause"
    type="button"
    data-pause
    data-label-pause={s.pause}
    data-label-play={s.play}
    aria-label={s.pause}
  >
    <span class="i-pause" set:html={pauseIcon} />
    <span class="i-play" set:html={playIcon} />
  </button>
</section>

<style>
  /* Text and card read as one centred pair with a fixed gap. */
  .story {
    --card-w: min(500px, 42vw);
    --text-w: min(420px, 34vw);
    --pair-gap: clamp(48px, 6vw, 104px);
    --pair-w: min(calc(var(--text-w) + var(--pair-gap) + var(--card-w)), var(--colw));
    position: relative;
    display: grid;
  }
  .stage,
  .frames {
    grid-area: 1 / 1;
  }
  .story > :global(.rails) {
    grid-area: 1 / 1;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    align-self: start;
    pointer-events: none;
  }
  .stage-card {
    position: absolute;
    top: 50%;
    height: 0;
    width: var(--card-w);
    transition: left 0.8s var(--ease);
  }
  /* The card sits at the inner edges of the shared content column (see --colw). */
  .stage-card[data-side='right'] {
    left: calc(50% + var(--pair-w) / 2 - var(--card-w));
  }
  .stage-card[data-side='left'] {
    left: calc(50% - var(--pair-w) / 2);
  }
  .slot {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    opacity: 0;
    transform: translateY(calc(-50% + 16px)) scale(0.985);
    transition: opacity 0.45s var(--ease), transform 0.6s var(--ease);
    visibility: hidden;
  }
  .slot.active {
    opacity: 1;
    transform: translateY(-50%);
    visibility: visible;
  }
  .frame {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    width: var(--pair-w);
    margin: 0 auto;
  }
  .frame[data-side='right'] {
    justify-content: flex-end;
  }
  .frame-text {
    width: var(--text-w);
  }
  .frame[data-side='right'] .frame-text {
    margin-right: 0;
  }
  .frame-text .lead {
    margin: 18px 0 0;
  }
  /* The accessible copy of each visual; shown on phones, visually hidden on desktop. */
  .frame-visual {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .pause {
    position: absolute;
    right: 28px;
    bottom: 28px;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 0;
    cursor: pointer;
    display: grid;
    place-items: center;
    background: var(--btn2);
    color: var(--btn2-ink);
    box-shadow: inset 0 0 0 1px var(--line);
    position: sticky;
    grid-area: 1 / 1;
    align-self: end;
    justify-self: end;
    margin: 0 calc(max(var(--rail-gap), (100vw - 1440px) / 2) + 10px) 24px 0;
    z-index: 2;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s var(--ease), visibility 0.3s;
  }
  .story.in-view .pause {
    opacity: 1;
    visibility: visible;
  }
  .pause :global(svg) {
    width: 14px;
    height: 14px;
  }
  .i-play {
    display: none;
  }
  .story.is-paused .i-play {
    display: block;
  }
  .story.is-paused .i-pause {
    display: none;
  }

  @media (max-width: 767px) {
    .stage,
    .pause {
      display: none;
    }
    .frame {
      width: var(--colw);
      min-height: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      padding-top: 56px;
      padding-bottom: 8px;
    }
    .frame[data-side='right'] .frame-text {
      margin-right: 0;
    }
    .frame-text {
      width: auto;
    }
    .frame-visual {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pause {
      display: none;
    }
  }
</style>

<script>
  import { initStory } from '../scripts/story';
  initStory();
</script>
