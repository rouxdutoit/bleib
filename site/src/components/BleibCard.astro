---
/**
 * bleib's card inside a chat, as in the hero and the closer: what bleib offers, with one action that turns
 * bleib yellow when done. It reveals at step `at` (2 or 3) and its action completes one step later (motion kit in global.css).
 * Spacing around it comes from --bleib-card-margin on the parent.
 */
import Mark from './Mark.astro';
import DrawTick from './DrawTick.astro';
import { icon } from './icons';
interface Props { title: string; facts: string[]; action: string; done: string; at?: 2 | 3 }
const { title, facts, action, done, at = 2 } = Astro.props;
---
<div class={`reveal at-${at}`}><div class="reveal-in">
  <div class="fill">
    <p class="fill-head"><span class="app"><Mark size={12} /></span><span class="t-foot fill-title">{title}</span></p>
    <ul class="facts">{facts.map((f) => <li class="t-sub"><span class="yes" set:html={icon('check')} />{f}</li>)}</ul>
    <span class={`b crossfade press at-${at + 1}`}><span>{action}</span><span class="to-done"><span class="tick"><DrawTick /></span>{done}</span></span>
  </div>
</div></div>

<style>
  /* Like a notification row: the action sits at the end, centred on the whole card. */
  .fill { margin: var(--bleib-card-margin, 0); padding: 10px 12px 12px; border-radius: 14px; background: var(--fill); display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 12px; align-items: center; }
  .fill-head { margin: 0; display: flex; align-items: center; gap: 8px; }
  .app { flex: none; width: 22px; height: 22px; border-radius: 6px; display: grid; place-items: center; background: #0a0a0a; color: #f6e79a; }
  .fill-title { color: var(--label-2); }
  .facts { grid-column: 1; min-width: 0; list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .facts li { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .yes { flex: none; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: #f6e79a; color: #0a0a0a; }
  .yes :global(svg) { width: 13px; height: 13px; display: block; }
  /* Like the story cards: the action in the label colour, bleib yellow once done; labels crossfade in place. */
  .b { grid-column: 2; grid-row: 1 / span 2; place-items: center; height: 28px; padding: 0 12px; border-radius: 999px; font-size: 13px; line-height: 1; font-weight: 600; background: var(--label); color: var(--cell); transition: background-color var(--t-fade) var(--ease), color var(--t-fade) var(--ease); }
  .to-done { display: inline-flex; align-items: center; gap: 4px; }
  :global(.s3) .b.at-3, :global(.s4) .b.at-4 { background: #f6e79a; color: #0a0a0a; }
  .tick { display: grid; }
  /* On phones the title keeps the full width. The action sits beside the facts when there is room
     and otherwise moves to its own line at the end, so it never crowds them. */
  @media (max-width: 480px) {
    .fill { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; }
    .fill-head { flex-basis: 100%; }
    .facts { margin: 0; }
    .b { margin-inline-start: auto; }
  }
</style>
