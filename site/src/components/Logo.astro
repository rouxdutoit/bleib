---
/**
 * The bleib logo: the mark and "bleib" as one outlined lockup (Inter 600, -0.04em, drawn as paths), so it looks the
 * same on every computer whatever fonts it has. The spec is docs/brand/wordmark.md on the extension branch.
 * One colour everywhere through currentColor: black in light mode, bleib yellow in dark mode.
 */
import lockup from './bleib-lockup-current.svg?raw';
import { routes, t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<a class="logo" href={routes.home[lang]} aria-label={t(lang).nav.home}>
  <span class="logo-art" aria-hidden="true" set:html={lockup} />
</a>
<style>
  .logo { display: inline-flex; align-items: center; text-decoration: none; min-height: 44px; color: #0a0a0a; }
  :global(:root[data-theme='dark']) .logo { color: #f6e79a; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo { color: #f6e79a; }
  }
  .logo-art { display: inline-grid; }
  .logo-art :global(svg) { display: block; width: auto; height: 25px; }
</style>
